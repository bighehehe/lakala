---
---

<div id="apply-modal" class="fixed inset-0 z-[100] flex items-center justify-center hidden">
  <!-- Backdrop -->
  <div id="apply-modal-backdrop" class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>

  <!-- Modal Content -->
  <div id="apply-modal-content" class="relative w-[calc(100%-2rem)] max-w-md mx-auto bg-white rounded-2xl shadow-2xl overflow-hidden transform scale-95 opacity-0 transition-all duration-300 flex flex-col max-h-[90vh]">
    <!-- Header -->
    <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50">
      <h3 class="text-xl font-bold text-slate-800">免费申请办理</h3>
      <button id="apply-modal-close" class="text-slate-400 hover:text-slate-600 transition-colors p-1 rounded-full hover:bg-slate-200 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>

    <!-- Body -->
    <div class="p-6 overflow-y-auto">
      <form id="apply-form" class="space-y-5">
        <div>
          <label for="apply-name" class="block text-sm font-medium text-slate-700 mb-1">您的姓名 <span class="text-red-500">*</span></label>
          <input type="text" id="apply-name" required class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all" placeholder="请输入您的姓名" />
        </div>
        
        <div>
          <label for="apply-phone" class="block text-sm font-medium text-slate-700 mb-1">手机号码 <span class="text-red-500">*</span></label>
          <input type="tel" id="apply-phone" required pattern="^1[3-9]\\d{9}$" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all" placeholder="请输入11位手机号码" title="请输入有效的11位手机号码" />
        </div>

        <div class="relative w-full">
          <label for="apply-type-trigger" class="block text-sm font-medium text-slate-700 mb-1">意向机型 <span class="text-red-500">*</span></label>
          <input id="apply-type" type="hidden" />
          <button
            id="apply-type-trigger"
            type="button"
            aria-haspopup="listbox"
            aria-expanded="false"
            class="flex w-full items-center justify-between gap-3 rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-left transition-all focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500"
          >
            <span id="apply-type-label" class="min-w-0 flex-1 truncate text-slate-400">请选择您想办理的机型</span>
            <svg id="apply-type-icon" class="h-4 w-4 flex-shrink-0 text-slate-500 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <div id="apply-type-menu" class="absolute left-0 right-0 top-full z-20 mt-2 hidden overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl">
            <button type="button" data-apply-type-option data-value="电签POS" class="block w-full px-4 py-3 text-left text-sm text-slate-700 transition-colors hover:bg-brand-50 hover:text-brand-600">拉卡拉电签POS（个人/小微）</button>
            <button type="button" data-apply-type-option data-value="大POS" class="block w-full border-t border-slate-100 px-4 py-3 text-left text-sm text-slate-700 transition-colors hover:bg-brand-50 hover:text-brand-600">拉卡拉大POS（商户/门店）</button>
            <button type="button" data-apply-type-option data-value="智能POS" class="block w-full border-t border-slate-100 px-4 py-3 text-left text-sm text-slate-700 transition-colors hover:bg-brand-50 hover:text-brand-600">拉卡拉智能POS（智能收银）</button>
            <button type="button" data-apply-type-option data-value="收款码" class="block w-full border-t border-slate-100 px-4 py-3 text-left text-sm text-slate-700 transition-colors hover:bg-brand-50 hover:text-brand-600">拉卡拉收款码（聚合支付）</button>
          </div>
        </div>

        <div>
          <label for="apply-message" class="block text-sm font-medium text-slate-700 mb-1">留言 <span class="text-slate-400 text-xs font-normal">(可选)</span></label>
          <textarea id="apply-message" rows="3" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all resize-none" placeholder="如果您有任何其他需求或疑问，请在此留言"></textarea>
        </div>

        <button type="submit" class="w-full py-3.5 px-4 bg-brand-600 hover:bg-brand-700 text-white rounded-lg font-bold text-lg shadow-md shadow-brand-500/30 transition-all focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 mt-4 cursor-pointer">
          提交申请
        </button>
      </form>

      <!-- Success Message -->
      <div id="apply-success" class="hidden flex-col items-center justify-center py-12 text-center h-full min-h-[300px]">
        <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mb-6 mx-auto">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-green-600"><path d="M20 6 9 17l-5-5"/></svg>
        </div>
        <h4 class="text-2xl font-bold text-slate-800 mb-3">提交成功！</h4>
        <p class="text-slate-600 text-lg">我们的客服专员将会在24小时内与您联系，请保持电话畅通。</p>
      </div>
    </div>
  </div>
</div>

<script>
  function initApplyModal() {
    const modal = document.getElementById('apply-modal');
    const backdrop = document.getElementById('apply-modal-backdrop');
    const content = document.getElementById('apply-modal-content');
    const closeBtn = document.getElementById('apply-modal-close');
    const form = document.getElementById('apply-form') as HTMLFormElement;
    const successMsg = document.getElementById('apply-success');
    const typeInput = document.getElementById('apply-type') as HTMLInputElement;
    const typeTrigger = document.getElementById('apply-type-trigger') as HTMLButtonElement;
    const typeLabel = document.getElementById('apply-type-label');
    const typeMenu = document.getElementById('apply-type-menu');
    const typeIcon = document.getElementById('apply-type-icon');
    const typeOptions = document.querySelectorAll('[data-apply-type-option]');
    
    if (!modal || modal.dataset.initialized === 'true') return;
    modal.dataset.initialized = 'true';

    const openBtns = document.querySelectorAll('.apply-modal-trigger');

    function closeTypeMenu() {
      if (!typeMenu || !typeTrigger || !typeIcon) return;
      typeMenu.classList.add('hidden');
      typeTrigger.setAttribute('aria-expanded', 'false');
      typeIcon.classList.remove('rotate-180');
    }

    function toggleTypeMenu() {
      if (!typeMenu || !typeTrigger || !typeIcon) return;
      const isHidden = typeMenu.classList.contains('hidden');
      if (isHidden) {
        typeMenu.classList.remove('hidden');
        typeTrigger.setAttribute('aria-expanded', 'true');
        typeIcon.classList.add('rotate-180');
        return;
      }
      closeTypeMenu();
    }

    function resetTypeField() {
      if (!typeInput || !typeLabel || !typeTrigger) return;
      typeInput.value = '';
      typeLabel.textContent = '请选择您想办理的机型';
      typeLabel.classList.remove('text-slate-700');
      typeLabel.classList.add('text-slate-400');
      typeTrigger.classList.remove('border-red-500', 'ring-2', 'ring-red-200');
      closeTypeMenu();
    }

    function setTypeValue(value: string, label: string) {
      if (!typeInput || !typeLabel || !typeTrigger) return;
      typeInput.value = value;
      typeLabel.textContent = label;
      typeLabel.classList.remove('text-slate-400');
      typeLabel.classList.add('text-slate-700');
      typeTrigger.classList.remove('border-red-500', 'ring-2', 'ring-red-200');
      closeTypeMenu();
    }

    function openModal() {
      if (!modal || !backdrop || !content) return;
      modal.classList.remove('hidden');
      // Trigger reflow for transition
      void modal.offsetWidth;
      backdrop.classList.remove('opacity-0');
      backdrop.classList.add('opacity-100');
      content.classList.remove('opacity-0', 'scale-95');
      content.classList.add('opacity-100', 'scale-100');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!backdrop || !content) return;
      closeTypeMenu();
      backdrop.classList.remove('opacity-100');
      backdrop.classList.add('opacity-0');
      content.classList.remove('opacity-100', 'scale-100');
      content.classList.add('opacity-0', 'scale-95');
      
      setTimeout(() => {
        modal?.classList.add('hidden');
        document.body.style.overflow = '';
        // Reset form state after hidden
        if (form && successMsg) {
          form.reset();
          resetTypeField();
          form.classList.remove('hidden');
          successMsg.classList.add('hidden');
          const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
          if (submitBtn) {
            submitBtn.textContent = '提交申请';
            submitBtn.disabled = false;
          }
        }
      }, 300);
    }

    openBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);
    typeTrigger?.addEventListener('click', (e) => {
      e.preventDefault();
      toggleTypeMenu();
    });

    typeOptions.forEach((option) => {
      option.addEventListener('click', () => {
        const btn = option as HTMLButtonElement;
        setTypeValue(btn.dataset.value || '', btn.textContent?.trim() || '');
      });
    });

    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!typeTrigger?.contains(target) && !typeMenu?.contains(target)) {
        closeTypeMenu();
      }
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!typeInput?.value) {
        typeTrigger?.classList.add('border-red-500', 'ring-2', 'ring-red-200');
        typeTrigger?.focus();
        return;
      }

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.textContent = '正在提交...';
        submitBtn.disabled = true;

        const nameInput = document.getElementById('apply-name') as HTMLInputElement;
        const phoneInput = document.getElementById('apply-phone') as HTMLInputElement;
        const messageInput = document.getElementById('apply-message') as HTMLTextAreaElement;

        const path = window.location.pathname;
        let sourceName = '首页';
        if (path === '/contact') sourceName = '联系我们';
        else if (path.startsWith('/products/')) sourceName = '产品详情页';
        else if (path.startsWith('/pos-guide/') || path === '/pos-guide') sourceName = 'POS办理指南';
        else if (path.startsWith('/blog')) sourceName = '博客资讯';
        else if (path.startsWith('/faq')) sourceName = '常见问题';
        else if (path !== '/') sourceName = '其他页面';

        const payload = {
          "姓名": nameInput?.value || '',
          "电话": phoneInput?.value || '',
          "产品": typeInput?.value || '',
          "留言": messageInput?.value || '',
          "网站": "拉卡拉",
          "来源": sourceName,
          "时间": new Date().toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai' })
        };
        
        try {
          const response = await fetch('https://text.pingbal.com/webhook', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
          });

          // 因为 mode: 'no-cors' 下无法读取真正的 response.ok，
          // 只要没有抛出网络异常，我们就当它成功了
          form.classList.add('hidden');
          successMsg?.classList.remove('hidden');
          
          // 成功后延迟关闭
          setTimeout(() => {
            closeModal();
          }, 3000);
        } catch (error) {
          alert('提交失败，请稍后重试或直接联系客服。');
          submitBtn.textContent = '提交申请';
          submitBtn.disabled = false;
        }
      }
    });
  }

  // Handle both standard load and Astro view transitions
  initApplyModal();
  document.addEventListener('astro:page-load', initApplyModal);
</script>
