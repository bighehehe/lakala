---
---

<div id="ai-assistant" class="relative z-50">
  <div id="ai-container" class="fixed right-0 top-[80%] -translate-y-1/2 flex items-start z-[60] transition-transform duration-300 translate-x-[200px]">
    
    <button
      id="ai-toggle-btn"
      class="w-10 py-3 rounded-l-md bg-[#2B60DF] shadow-[-4px_0_12px_rgba(37,99,235,0.2)] flex flex-col items-center justify-center text-white cursor-pointer"
      aria-label="打开客服"
    >
      <svg class="w-5 h-5 mb-2" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 3a9 9 0 0 0-9 9v7c0 1.1.9 2 2 2h4v-8H5v-1a7 7 0 0 1 14 0v1h-4v8h4c1.1 0 2-.9 2-2v-7a9 9 0 0 0-9-9z"/>
      </svg>
      <div class="flex flex-col gap-1 text-[13px] font-bold tracking-widest text-white leading-none">
        <span>联</span>
        <span>系</span>
        <span>咨</span>
        <span>询</span>
      </div>
      <svg class="w-3.5 h-3.5 mt-2 transition-transform duration-300" id="ai-toggle-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="13 17 8 12 13 7"></polyline><polyline points="20 17 15 12 20 7"></polyline></svg>
    </button>

    <div
      id="ai-chat-window"
      class="w-[200px] bg-white flex flex-col border-[2px] border-[#2B60DF] shadow-lg"
    >
      <div class="p-3 pb-2.5 flex flex-col items-center border-b border-slate-100">
        <h3 class="text-[17px] font-bold text-slate-800 mb-2 tracking-wide">400-926-6655</h3>
        <a href="/contact" class="w-[85%] py-2 bg-[#2B60DF] hover:bg-blue-700 text-white rounded text-sm font-medium text-center transition-colors">
          办理咨询
        </a>
      </div>

      <div class="p-3 flex flex-col items-center">
        <div class="w-36 h-36 bg-white relative">
          <img src="/wechat.jpg" alt="拉卡拉客服微信二维码" class="w-full h-full object-contain" />
        </div>
      </div>
    </div>

  </div>
  <div id="ai-overlay" class="fixed inset-0 bg-transparent z-[50] transition-opacity duration-300 opacity-0 pointer-events-none"></div>
</div>

<script>
  const toggleBtn = document.getElementById('ai-toggle-btn');
  const container = document.getElementById('ai-container');
  const overlay = document.getElementById('ai-overlay');
  const toggleIcon = document.getElementById('ai-toggle-icon');

  let isOpen = false;

  function toggleDrawer() {
    isOpen = !isOpen;
    if (isOpen) {
      container?.classList.remove('translate-x-[200px]');
      overlay?.classList.remove('opacity-0', 'pointer-events-none');
      overlay?.classList.add('opacity-100', 'pointer-events-auto');
      toggleIcon?.classList.add('rotate-180');
    } else {
      container?.classList.add('translate-x-[200px]');
      overlay?.classList.remove('opacity-100', 'pointer-events-auto');
      overlay?.classList.add('opacity-0', 'pointer-events-none');
      toggleIcon?.classList.remove('rotate-180');
    }
  }

  function closeDrawer() {
    if (!isOpen) return;
    isOpen = false;
    container?.classList.add('translate-x-[200px]');
    overlay?.classList.remove('opacity-100', 'pointer-events-auto');
    overlay?.classList.add('opacity-0', 'pointer-events-none');
    toggleIcon?.classList.remove('rotate-180');
  }

  toggleBtn?.addEventListener('click', toggleDrawer);
  overlay?.addEventListener('click', closeDrawer);
</script>
