---
import { products } from '../data/products';

const NAV_ITEMS = [
  { label: '首页', path: '/' },
  { 
    label: 'POS产品', 
    path: '#',
    children: products.map(p => ({ label: p.name, path: `/products/${p.slug}` }))
  },
  { label: 'POS办理', path: '/articles/group-a' },
  { label: 'POS费率', path: '/articles/group-b' },
  { label: '使用问题', path: '/articles/group-d' },
  { label: '联系我们', path: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed w-full z-50 transition-all duration-300 bg-white shadow-md py-2">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center">
      <a href="/" class="flex items-center space-x-2">
        <img src="/img/logo.webp" alt="拉卡拉" class="h-10 w-auto" />
        <span class="text-2xl font-bold tracking-tight text-slate-800">拉卡拉</span>
      </a>

      <nav class="hidden md:flex items-center space-x-6 lg:space-x-8">
        {NAV_ITEMS.map((item) => (
          item.children ? (
            <div class="relative group">
              <a
                href={item.path}
                class={`flex items-center text-sm lg:text-base font-medium transition-colors duration-200 py-4 ${
                  currentPath === item.path || (item.path !== '/' && currentPath.startsWith(item.path))
                    ? 'text-brand-600 font-bold'
                    : 'text-slate-600 hover:text-brand-600'
                }`}
              >
                {item.label}
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1 w-4 h-4 transition-transform group-hover:rotate-180"><path d="m6 9 6 6 6-6"/></svg>
              </a>
              <div class="absolute left-0 top-full hidden group-hover:block w-48 bg-white shadow-xl rounded-xl border border-slate-100 py-2 z-50 transform opacity-0 group-hover:opacity-100 transition-opacity">
                {item.children.map((child) => (
                  <a
                    href={child.path}
                    class={`block px-4 py-2.5 text-sm transition-colors ${
                      currentPath === child.path
                        ? 'text-brand-600 bg-brand-50 font-medium'
                        : 'text-slate-600 hover:text-brand-600 hover:bg-slate-50'
                    }`}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.path}
              class={`block text-sm lg:text-base font-medium transition-colors duration-200 py-4 ${
                currentPath === item.path || (item.path !== '/' && currentPath.startsWith(item.path))
                  ? 'text-brand-600 font-bold'
                  : 'text-slate-600 hover:text-brand-600'
              }`}
            >
              {item.label}
            </a>
          )
        ))}
      </nav>

      <div class="md:hidden">
        <button
          id="mobile-menu-btn"
          class="p-2 rounded-md text-slate-800"
          aria-label="切换菜单"
        >
          <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
          <svg id="close-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-overlay"
    class="md:hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-40 transition-opacity duration-300 opacity-0 pointer-events-none"
  />

  <div
    id="mobile-drawer"
    class="md:hidden fixed inset-y-0 right-0 w-64 bg-white shadow-2xl z-50 transform transition-transform duration-300 translate-x-full overflow-y-auto"
  >
    <div class="flex flex-col h-full pt-20 px-6 pb-6 space-y-2">
      {NAV_ITEMS.map((item) => (
        item.children ? (
          <div class="flex flex-col border-b border-gray-100 pb-2 mb-2">
            <a
              href={item.path}
              class={`text-lg font-medium py-2 ${
                currentPath === item.path || (item.path !== '/' && currentPath.startsWith(item.path))
                  ? 'text-brand-600'
                  : 'text-slate-600'
              }`}
            >
              {item.label}
            </a>
            <div class="flex flex-col pl-4 space-y-1 mt-1">
              {item.children.map((child) => (
                <a
                  href={child.path}
                  class={`text-base py-1.5 ${
                    currentPath === child.path
                      ? 'text-brand-600 font-medium'
                      : 'text-slate-500'
                  }`}
                >
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={item.path}
            class={`text-lg font-medium border-b border-gray-100 pb-4 mb-2 py-2 ${
              currentPath === item.path || (item.path !== '/' && currentPath.startsWith(item.path))
                ? 'text-brand-600 border-brand-600'
                : 'text-slate-600'
            }`}
          >
            {item.label}
          </a>
        )
      ))}
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const overlay = document.getElementById('mobile-overlay');
  const drawer = document.getElementById('mobile-drawer');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');
  let isOpen = false;

  function toggleMenu() {
    isOpen = !isOpen;
    if (isOpen) {
      overlay?.classList.remove('opacity-0', 'pointer-events-none');
      overlay?.classList.add('opacity-100');
      drawer?.classList.remove('translate-x-full');
      drawer?.classList.add('translate-x-0');
      menuIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    } else {
      overlay?.classList.add('opacity-0', 'pointer-events-none');
      overlay?.classList.remove('opacity-100');
      drawer?.classList.add('translate-x-full');
      drawer?.classList.remove('translate-x-0');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }
  }

  menuBtn?.addEventListener('click', toggleMenu);
  overlay?.addEventListener('click', toggleMenu);
</script>
