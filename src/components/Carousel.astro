      { icon: 'cloud', title: '云闪付', desc: '银联认证' },
      { icon: 'shield', title: '资金安全', desc: '央行牌照' }
    ],
    buttonText: '立即申请',
    secondaryButtonText: '了解费率详情',
    link: '/contact'
  },
  {
    image: '/img/banner2.webp',
    title: '聚合收款更简单',
    subtitle: '微信 / 支付宝 / 云闪付 / 银联二维码，一码多收',
    features: [
      { icon: 'shield', title: '到账稳定', desc: '资金安全 实时到账' },
      { icon: 'bill', title: '对账清晰', desc: '多维报表 一目了然' },
      { icon: 'touch', title: '操作便捷', desc: '流程简单 快速收款' }
    ],
    buttonText: '了解方案',
    secondaryButtonText: '了解费率详情',
    link: '/products/lakala-dianqian-pos'
  },
  {
    image: '/img/banner3.webp',
    title: '多款机型可选',
    subtitle: '电签POS / 智能POS / 扫码牌，覆盖多种收款场景',
    features: [
      { icon: 'bag', title: '便携好用' },
      { icon: 'diamond', title: '外观时尚' },
      { icon: 'grid', title: '适配灵活' }
    ],
    buttonText: '查看机型',
    secondaryButtonText: '了解费率详情',
    link: '/products/lakala-da-pos'
  },
  {
    image: '/img/banner4.webp',
    title: '安全稳定 收款高效',
    subtitle: '央行牌照 · 多种支付方式 · 资金到账更安心',
    features: [
      { icon: 'shield-check', title: '资金安全', desc: '央行牌照保障' },
      { icon: 'layer', title: '交易稳定', desc: '系统稳定可靠' },
      { icon: 'rocket', title: '快速上手', desc: '操作简单易用' }
    ],
    buttonText: '立即了解',
    secondaryButtonText: '了解费率详情',
    link: '/products/lakala-zhineng-pos'
  }
];

const getIconSvg = (name: string) => {
  switch(name) {
    case 'card': return '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>';
    case 'scan': return '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="5" height="5" x="3" y="3" rx="1"/><rect width="5" height="5" x="16" y="3" rx="1"/><rect width="5" height="5" x="3" y="16" rx="1"/><path d="M21 16v5h-5"/><path d="M21 21v-5h-5"/><path d="M8 3v5H3"/><path d="M16 3v5h5"/><path d="M3 16v5h5"/><path d="M12 8v8"/><path d="M8 12h8"/></svg>';
    case 'cloud': return '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>';
    case 'shield': return '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>';
    case 'bill': return '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>';
    case 'touch': return '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 11.5V6a4 4 0 0 1 8 0v8.5"/><path d="M16 14.5v-3"/><path d="M20 16.5v-2"/><path d="M4 14.5v2"/><path d="M12 2v2"/><path d="M22 22 12 12"/><path d="m2 22 10-10"/></svg>';
    case 'bag': return '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>';
    case 'diamond': return '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 13L2 9Z"/><path d="M11 3 8 9l4 13"/><path d="M13 3l3 6-4 13"/></svg>';
    case 'grid': return '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>';
    case 'shield-check': return '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>';
    case 'layer': return '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>';
    case 'rocket': return '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5-2 5-2"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 2-5 2-5"/></svg>';
    default: return '';
  }
};
---

<!-- 桌面端 Banner (sm 及以上显示) -->
<div class="hidden sm:block relative w-full overflow-hidden group mt-[56px]" id="banner-carousel">
  <div class="flex transition-transform duration-500 ease-in-out" id="carousel-inner">
    {banners.map((banner, index) => (
      <div class="w-full flex-shrink-0 relative">
        <img src={banner.image} alt={banner.title} class="w-full h-auto block object-contain" />
        
        <div class="absolute inset-0 flex items-center z-10">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
            <div class="w-full md:w-1/2 lg:w-5/12 text-slate-800">
              <div class="flex items-center space-x-2 mb-4">
                <img src="/img/logo.webp" alt="拉卡拉" class="h-6 md:h-10 w-auto" />
                <span class="text-sm md:text-base text-slate-600 mt-1 inline-block">给每个梦想一个机会</span>
              </div>
              
              <h2 class="text-3xl md:text-5xl lg:text-6xl font-extrabold tracking-tight mb-4 text-brand-600">
                {banner.title}
              </h2>
              <div class="w-12 md:w-16 h-1 bg-brand-500 mb-4 rounded-full"></div>
              <p class="text-base md:text-lg lg:text-xl text-slate-700 mb-8 font-medium">
                {banner.subtitle}
              </p>
              
              <div class="flex flex-wrap gap-4 md:gap-6 mb-10">
                {banner.features.map((feature) => (
                  <div class="flex flex-col items-start text-left">
                    <div class="w-8 h-8 md:w-12 md:h-12 bg-white rounded-xl shadow-sm border border-brand-100 flex items-center justify-center text-brand-500 mb-2 [&>svg]:w-4 [&>svg]:h-4 md:[&>svg]:w-6 md:[&>svg]:h-6" set:html={getIconSvg(feature.icon)} />
                    <span class="text-xs md:text-sm font-bold text-slate-800">{feature.title}</span>
                    {feature.desc && <span class="block text-xs text-slate-500 mt-0.5">{feature.desc}</span>}
                  </div>
                ))}
              </div>
              
              <button class="apply-modal-trigger inline-flex items-center justify-center font-medium transition-all duration-300 rounded-full focus:outline-none focus:ring-2 focus:ring-offset-2 bg-gradient-to-r from-brand-500 to-brand-600 hover:from-brand-600 hover:to-brand-700 text-white shadow-lg shadow-brand-500/40 hover:shadow-brand-500/60 hover:-translate-y-0.5 px-6 md:px-10 py-2 md:py-4 text-sm md:text-lg cursor-pointer">
                {banner.buttonText}
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2 w-4 h-4 md:w-5 md:h-5"><path d="m9 18 6-6-6-6"/></svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
  
  <!-- Navigation Arrows -->
  <button class="absolute top-1/2 left-4 -translate-y-1/2 bg-black/30 hover:bg-black/50 text-white p-2 rounded-full opacity-0 group-hover:opacity-100 transition-opacity z-10" id="prev-btn" aria-label="Previous slide">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
  </button>
  <button class="absolute top-1/2 right-4 -translate-y-1/2 bg-black/30 hover:bg-black/50 text-white p-2 rounded-full opacity-0 group-hover:opacity-100 transition-opacity z-10" id="next-btn" aria-label="Next slide">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
  </button>

  <!-- Pagination Dots -->
  <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex space-x-2 z-10">
    {banners.map((_, index) => (
      <button class={`w-3 h-3 rounded-full transition-colors dot-btn ${index === 0 ? 'bg-white' : 'bg-white/50'}`} data-index={index} aria-label={`Go to slide ${index + 1}`}></button>
    ))}
  </div>
</div>

<!-- 移动端文本卡片区 (小屏显示，不轮播) -->
<div class="sm:hidden w-full mt-[56px] bg-gradient-to-br from-[#f0f4ff] to-[#f8f9fb]">
  <div class="px-6 py-10">
    <div class="flex items-center space-x-2 mb-5">
      <img src="/img/logo.webp" alt="拉卡拉" class="h-7 w-auto" />
      <span class="text-xs text-slate-500">给每个梦想一个机会</span>
    </div>

    <h2 class="text-[28px] font-black tracking-tight text-slate-900 leading-tight mb-3">
      拉卡拉POS机<br/>正规办理 · 安全收款
    </h2>

    <div class="flex items-center gap-2 mb-5">
      <span class="px-2.5 py-1 bg-[#0d6efd]/10 text-[#0d6efd] rounded text-xs font-bold">央行牌照</span>
      <span class="px-2.5 py-1 bg-[#0d6efd]/10 text-[#0d6efd] rounded text-xs font-bold">一清机</span>
      <span class="px-2.5 py-1 bg-[#0d6efd]/10 text-[#0d6efd] rounded text-xs font-bold">秒到账</span>
    </div>

    <p class="text-[13px] text-slate-500 leading-relaxed mb-8">
      个人、小微商户正规POS办理渠道。支持刷卡、扫码、云闪付全场景收款，费率透明无隐藏扣费，资金安全有保障。
    </p>

    <div class="grid grid-cols-3 gap-3 mb-8">
      <div class="bg-white rounded-lg p-3 text-center shadow-sm">
        <div class="text-xl font-black text-[#0d6efd]">0.6%</div>
        <div class="text-[11px] text-slate-500 mt-1">标准费率</div>
      </div>
      <div class="bg-white rounded-lg p-3 text-center shadow-sm">
        <div class="text-xl font-black text-[#0d6efd]">秒到</div>
        <div class="text-[11px] text-slate-500 mt-1">实时到账</div>
      </div>
      <div class="bg-white rounded-lg p-3 text-center shadow-sm">
        <div class="text-xl font-black text-[#0d6efd]">免费</div>
        <div class="text-[11px] text-slate-500 mt-1">包邮到家</div>
      </div>
    </div>

    <div class="flex gap-3">
      <button class="apply-modal-trigger flex-1 flex items-center justify-center gap-1 bg-[#0d6efd] text-white py-3.5 rounded-lg font-bold text-sm shadow-[0_4px_12px_rgba(13,110,253,0.3)] cursor-pointer">
        立即申请
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </button>
      <a href="/pos-guide" class="flex-1 flex items-center justify-center bg-white text-[#0d6efd] py-3.5 rounded-lg font-bold text-sm shadow-[0_2px_8px_rgba(0,0,0,0.05)] border border-slate-200">
        了解详情
      </a>
    </div>

    <div class="mt-8">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-base font-bold text-slate-800">热门产品</h3>
        <a href="/products/lakala-dianqian-pos" class="text-xs text-[#0d6efd] font-medium">查看全部</a>
      </div>
      <div class="flex gap-3 overflow-x-auto hide-scrollbar snap-x snap-mandatory pb-2" id="mobile-product-scroll">
        {products.map((product) => (
          <a href={product.link} class="flex-shrink-0 w-[140px] snap-start bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden group">
            <div class="aspect-square p-4 flex items-center justify-center bg-slate-50">
              <img src={product.image} alt={product.title} class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" />
            </div>
            <div class="px-3 py-2.5 text-center">
              <span class="text-xs font-bold text-slate-700 block truncate">{product.title}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  // 桌面端轮播逻辑
  const carousel = document.getElementById('banner-carousel');
  const inner = document.getElementById('carousel-inner');
  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');
  const dots = document.querySelectorAll('.dot-btn');
  
  if (carousel && inner && prevBtn && nextBtn && dots.length > 0) {
    let currentIndex = 0;
    const totalSlides = dots.length;
    let autoPlayInterval: number;

    function updateSlider() {
      if (inner) {
        inner.style.transform = `translateX(-${currentIndex * 100}%)`;
      }
      dots.forEach((dot, index) => {
        if (index === currentIndex) {
          dot.classList.remove('bg-white/50');
          dot.classList.add('bg-white');
        } else {
          dot.classList.remove('bg-white');
          dot.classList.add('bg-white/50');
        }
      });
    }

    function nextSlide() {
      currentIndex = (currentIndex + 1) % totalSlides;
      updateSlider();
    }

    function prevSlide() {
      currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
      updateSlider();
    }

    function startAutoPlay() {
      autoPlayInterval = window.setInterval(nextSlide, 5000);
    }

    function stopAutoPlay() {
      if (autoPlayInterval) {
        clearInterval(autoPlayInterval);
      }
    }

    nextBtn.addEventListener('click', () => {
      nextSlide();
      stopAutoPlay();
      startAutoPlay();
    });

    prevBtn.addEventListener('click', () => {
      prevSlide();
      stopAutoPlay();
      startAutoPlay();
    });

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        currentIndex = index;
        updateSlider();
        stopAutoPlay();
        startAutoPlay();
      });
    });

    carousel.addEventListener('mouseenter', stopAutoPlay);
    carousel.addEventListener('mouseleave', startAutoPlay);

    startAutoPlay();
  }
</script>
