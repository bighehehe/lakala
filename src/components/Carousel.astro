---
const products = [
  { image: '/img/拉卡拉大pos.webp', title: '拉卡拉大POS机', link: '/products/lakala-da-pos' },
  { image: '/img/拉卡拉电签.webp', title: '拉卡拉电签POS机', link: '/products/lakala-dianqian-pos' },
  { image: '/img/拉卡拉智能pos.webp', title: '拉卡拉智能POS机', link: '/products/lakala-zhineng-pos' },
  { image: '/img/拉卡拉收款码牌.webp', title: '拉卡拉收款码牌', link: '/products/lakala-shoukuanma' },
