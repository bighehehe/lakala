---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AIAssistant from '../../components/AIAssistant.astro';

export async function getStaticPaths() {
  return [
    { params: { group: 'group-a' }, props: { groupKey: 'A' } },
    { params: { group: 'group-b' }, props: { groupKey: 'B' } },
    { params: { group: 'group-d' }, props: { groupKey: 'D' } },
    { params: { group: 'group-e' }, props: { groupKey: 'E' } },
  ];
}

const { groupKey } = Astro.props;
const allArticles = await getCollection('articles');

const groupDefs: Record<string, {
  title: string;
  subtitle: string;
  bannerClass: string;
  pillarSlug: string;
  categories: string[];
}> = {
  A: {
    title: '拉卡拉POS办理指南',
    subtitle: '从申请条件、办理流程到激活使用，全方位解答',
    bannerClass: 'from-brand-900 via-brand-800 to-brand-700',
    pillarSlug: 'lakala-pos-banli-zhinan',
    categories: ['办理条件', '申请流程', '费用与合同', '渠道与避坑', '激活与使用'],
  },
  B: {
    title: '拉卡拉POS费率与费用',
    subtitle: '手续费、押金、流量费、秒到费，一次讲清所有费用问题',
    bannerClass: 'from-brand-900 via-brand-800 to-brand-700',
    pillarSlug: 'lakala-pos-feilv-zhinan',
    categories: ['手续费计算', '扫码费率', '流量费', '押金规则', '秒到费与涨价'],
  },
  D: {
    title: '拉卡拉POS使用问题与售后',
    subtitle: '不到账、交易失败、限额、换卡、注销，手把手教你处理各种问题',
    bannerClass: 'from-brand-900 via-brand-800 to-brand-700',
    pillarSlug: 'lakala-pos-shiyong-wenti-zhinan',
    categories: ['不到账', '交易失败', '限额', '结算卡与账户', '机器故障、流量卡、注销'],
  },
  E: {
    title: '拉卡拉POS安全合规与避坑',
    subtitle: '正规性、风控、跳码、骗局识别，帮你避开所有坑',
    bannerClass: 'from-amber-900 via-orange-800 to-amber-700',
    pillarSlug: 'lakala-pos-anquan-hegui-zhinan',
    categories: ['正规性与安全', '政策与行业变化', '风控、跳码、商户', '使用边界与风险提示', '骗局与避坑'],
  },
};

const group = groupDefs[groupKey];
const groupCats = new Set(group.categories);
const pillar = allArticles.find(a => a.id === group.pillarSlug);
const clusters = allArticles
  .filter(a => a.data.type === 'cluster' && groupCats.has(a.data.category));

// Group clusters by category in order
const grouped = new Map<string, typeof clusters>();
for (const cat of group.categories) {
  const items = clusters.filter(a => a.data.category === cat);
  if (items.length > 0) grouped.set(cat, items);
}

const categoryIcons: Record<string, string> = {
  '办理条件': '📋', '申请流程': '📝', '费用与合同': '💰',
  '渠道与避坑': '🛡️', '激活与使用': '🔧',
  '手续费计算': '🧮', '扫码费率': '📱', '流量费': '📶',
  '押金规则': '🔐', '秒到费与涨价': '⚡',
  '不到账': '❌', '交易失败': '⚠️', '限额': '📊',
  '结算卡与账户': '💳', '机器故障、流量卡、注销': '🔧',
  '正规性与安全': '🔒', '政策与行业变化': '📜',
  '风控、跳码、商户': '🔍', '使用边界与风险提示': '⚠️', '骗局与避坑': '🚫',
};

const categoryDescriptions: Record<string, string> = {
  '办理条件': '了解办理拉卡拉POS需要满足的条件和准备的资料',
  '申请流程': '从提交申请到审核通过，一步步教你操作',
  '费用与合同': '费用构成、合同条款和常见收费陷阱解读',
  '渠道与避坑': '如何选择靠谱渠道，避开办理中的常见坑',
  '激活与使用': '设备激活、绑卡、APP使用和日常操作指南',
  '手续费计算': '刷卡手续费怎么算？不同金额不同费率一目了然',
  '扫码费率': '微信、支付宝、银联扫码费率和限额详解',
  '流量费': 'POS机流量费怎么扣？一年多少钱？能退吗？',
  '押金规则': '激活押金、达标返还、退款条件全解析',
  '秒到费与涨价': '秒到费、服务费、费率调整，看懂不花冤枉钱',
  '不到账': '刷卡成功但钱没到？5步排查法帮你找到原因',
  '交易失败': '各种错误提示解读，从网络到银行问题全解析',
  '限额': '单笔单日限额、扫码刷卡限额、夜间限额详解',
  '结算卡与账户': '结算卡更换、银行卡异常、账户问题处理',
  '机器故障、流量卡、注销': '设备故障、流量卡续费、机器注销流程',
  '正规性与安全': '支付牌照、一清机、资金安全、正规性判断',
  '政策与行业变化': '259文件、一机一码、政策调整影响解析',
  '风控、跳码、商户': '风控触发原因、跳码识别、商户名称和MCC码解读',
  '使用边界与风险提示': '合规使用、风险行为、误导话术识别',
  '骗局与避坑': '办理骗局、押金套路、费率陷阱、代理失联处理',
};

function formatDate(dateStr: string | Date) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout title={`${group.title} - 拉卡拉`}>
  <Header />
  <main class="flex-grow pt-16 min-h-screen bg-slate-50">
    <!-- Hero Banner -->
    <section class={`bg-gradient-to-br ${group.bannerClass} text-white pt-24 pb-32 relative overflow-hidden`}>
      <!-- Background Effects -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-24 -left-24 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
        <div class="absolute top-1/2 right-0 w-[30rem] h-[30rem] bg-brand-400/20 rounded-full blur-3xl transform translate-x-1/3 -translate-y-1/2"></div>
        <div class="absolute bottom-0 left-1/4 w-[40rem] h-64 bg-brand-500/20 blur-3xl"></div>
      </div>
      
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <span class="inline-block py-1 px-3 rounded-full bg-white/10 border border-white/20 text-white/90 text-sm font-medium tracking-wider mb-6 backdrop-blur-sm">
          知识专栏
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 tracking-tight">
          {group.title}
        </h1>
        <p class="text-brand-100 text-lg md:text-xl max-w-2xl mx-auto leading-relaxed mb-10">
          {group.subtitle}
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="#topics" class="px-8 py-3.5 bg-white text-brand-900 font-bold rounded-full hover:bg-brand-50 transition-all duration-300 shadow-lg shadow-white/20 hover:scale-105">
            浏览话题
          </a>
          {pillar && (
            <a href={`/articles/${pillar.id}`} class="px-8 py-3.5 bg-brand-800/50 text-white border border-white/20 font-bold rounded-full hover:bg-brand-700/50 transition-all duration-300 backdrop-blur-sm hover:scale-105">
              阅读完整指南
            </a>
          )}
        </div>
      </div>
    </section>

    <!-- Quick Navigation (Table of Contents) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-16 relative z-20 mb-16">
      <div class="bg-white rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-100 p-6 md:p-8 backdrop-blur-xl">
        <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-6 text-center">快速导航</h3>
        <div class="flex flex-wrap justify-center gap-3">
          {Array.from(grouped.keys()).map((category) => (
            <a href={`#cat-${category}`} class="inline-flex items-center px-4 py-2 bg-slate-50 hover:bg-brand-50 border border-slate-100 hover:border-brand-200 rounded-full text-sm font-medium text-slate-700 hover:text-brand-700 transition-all duration-200 hover:shadow-sm">
              <span class="mr-2 text-base">{categoryIcons[category]}</span>
              {category}
            </a>
          ))}
        </div>
      </div>
    </div>

    <div id="topics" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      
      <!-- Pillar Highlight -->
      {pillar && (
        <section class="mb-20">
          <div class="flex items-center justify-between mb-8">
            <h2 class="text-2xl md:text-3xl font-bold text-slate-900 flex items-center">
              <span class="w-8 h-8 rounded-lg bg-brand-100 text-brand-600 flex items-center justify-center mr-3 text-sm">✨</span>
              核心指南
            </h2>
          </div>
          <a
            href={`/articles/${pillar.id}`}
            class="group block bg-white rounded-3xl shadow-md hover:shadow-2xl transition-all duration-500 overflow-hidden border border-slate-100 hover:border-brand-300 relative"
          >
            <div class="absolute top-0 left-0 w-1.5 h-full bg-brand-500 transform origin-left scale-y-0 group-hover:scale-y-100 transition-transform duration-500"></div>
            <div class="p-8 md:p-10 flex flex-col md:flex-row md:items-center gap-8">
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-4">
                  <span class="inline-flex items-center px-3 py-1 bg-brand-50 text-brand-700 text-xs font-bold rounded-full border border-brand-100">必读推荐</span>
                  <span class="text-sm text-slate-400 flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1.5"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                    {formatDate(pillar.data.created_at)}
                  </span>
                </div>
                <h3 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4 group-hover:text-brand-600 transition-colors leading-tight">
                  {pillar.data.title}
                </h3>
                <p class="text-slate-500 text-base leading-relaxed mb-6 max-w-3xl">
                  {pillar.data.summary}
                </p>
                <span class="inline-flex items-center text-brand-600 font-medium group-hover:translate-x-2 transition-transform duration-300">
                  开始阅读
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </span>
              </div>
            </div>
          </a>
        </section>
      )}

      <!-- Clusters by category -->
      <div class="space-y-20">
        {Array.from(grouped.entries()).map(([category, articles], catIndex) => (
          <section id={`cat-${category}`} class="scroll-mt-32">
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 pb-4 border-b border-slate-200">
              <div class="flex items-center">
                <span class="inline-flex items-center justify-center w-12 h-12 bg-white shadow-sm border border-slate-100 text-2xl rounded-xl mr-4 transform -rotate-3">
                  {categoryIcons[category] || '📄'}
                </span>
                <div>
                  <h2 class="text-2xl font-bold text-slate-900">{category}</h2>
                  <p class="text-slate-500 text-sm mt-1">{categoryDescriptions[category] || ''}</p>
                </div>
              </div>
              <div class="mt-4 md:mt-0 flex items-center gap-4">
                <span class="inline-flex items-center px-3 py-1 bg-slate-100 text-slate-600 rounded-full text-sm font-medium">
                  共 {articles.length} 篇文章
                </span>
                {articles.length > 3 && (
                  <div class="view-more-wrapper">
                    <button
                      class="inline-flex items-center px-4 py-1 bg-white border border-slate-200 text-slate-600 text-sm font-medium rounded-full hover:bg-slate-50 hover:text-brand-600 transition-colors shadow-sm view-more-btn"
                      data-target={`article-card-${catIndex}`}
                    >
                      查看更多
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                  </div>
                )}
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {articles.map((article, index) => (
                <a
                  href={`/articles/${article.id}`}
                  class={`group flex flex-col bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden border border-slate-100 hover:border-brand-200 h-full ${index >= 3 ? 'hidden' : ''} article-card-${catIndex}`}
                >
                  <div class="p-6 flex flex-col flex-grow">
                    <div class="flex items-center justify-between mb-4">
                      <span class="inline-flex items-center px-2.5 py-1 bg-slate-50 text-slate-600 text-xs font-medium rounded-md border border-slate-100">{category}</span>
                      <span class="text-xs text-slate-400">{formatDate(article.data.created_at)}</span>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-brand-600 transition-colors leading-snug">
                      {article.data.title}
                    </h3>
                    <p class="text-slate-500 text-sm line-clamp-3 leading-relaxed mb-6 flex-grow">
                      {article.data.summary}
                    </p>
                    <div class="mt-auto pt-4 border-t border-slate-50 flex items-center text-brand-600 text-sm font-medium">
                      <span>阅读全文</span>
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1.5 group-hover:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>

      <!-- Bottom CTA Section -->
      <section class="mt-24 mb-12">
        <div class="bg-gradient-to-r from-brand-900 to-brand-800 rounded-3xl p-8 md:p-12 text-center relative overflow-hidden">
          <div class="absolute top-0 right-0 -mt-10 -mr-10 w-40 h-40 bg-white opacity-10 rounded-full blur-2xl"></div>
          <div class="absolute bottom-0 left-0 -mb-10 -ml-10 w-40 h-40 bg-brand-400 opacity-20 rounded-full blur-2xl"></div>
          
          <div class="relative z-10">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">没有找到您想要的答案？</h2>
            <p class="text-brand-100 text-lg mb-8 max-w-2xl mx-auto">
              我们的专业客服团队随时为您解答POS办理、费率、售后等任何疑问，欢迎免费咨询。
            </p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
              <a href="/contact" class="inline-flex justify-center items-center px-8 py-3.5 bg-brand-500 text-white font-bold rounded-full hover:bg-brand-400 transition-colors shadow-lg shadow-brand-500/30">
                立即咨询
              </a>
              <a href="/contact" class="inline-flex justify-center items-center px-8 py-3.5 bg-white/10 text-white border border-white/20 font-bold rounded-full hover:bg-white/20 transition-colors backdrop-blur-sm">
                在线申请办理
              </a>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>
  <Footer />
  <AIAssistant />
</Layout>

<script>
  function setupViewMore() {
    const buttons = document.querySelectorAll('.view-more-btn');
    buttons.forEach(btn => {
      // Clone to remove existing event listeners if astro:page-load fires multiple times
      const clone = btn.cloneNode(true);
      btn.parentNode?.replaceChild(clone, btn);
      
      clone.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const targetClass = target.getAttribute('data-target');
        if (!targetClass) return;

        // Toggle state
        const isExpanded = target.getAttribute('data-expanded') === 'true';
        const newExpandedState = !isExpanded;
        target.setAttribute('data-expanded', newExpandedState.toString());

        // Update button text and icon
        const textNode = target.childNodes[0]; // Text is the first child node before the svg
        const svgPath = target.querySelector('path');
        
        if (newExpandedState) {
          target.innerHTML = `收起文章 <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1"><path d="m18 15-6-6-6 6"/></svg>`;
        } else {
          target.innerHTML = `查看更多 <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1"><path d="m6 9 6 6 6-6"/></svg>`;
        }

        // Toggle cards visibility
        // Only target cards from index 3 onwards (they have the hidden class initially)
        // We select all cards with the target class to figure out which ones to toggle
        const allCards = document.querySelectorAll(`.${targetClass}`);
        
        allCards.forEach((card, index) => {
          // We only toggle cards starting from the 4th one (index 3)
          if (index >= 3) {
            if (newExpandedState) {
              // Show card
              card.classList.remove('hidden');
              // Add a subtle fade-in animation
              card.animate([
                { opacity: 0, transform: 'translateY(10px)' },
                { opacity: 1, transform: 'translateY(0)' }
              ], {
                duration: 400,
                easing: 'ease-out',
                fill: 'forwards'
              });
            } else {
              // Hide card
              card.classList.add('hidden');
            }
          }
        });
      });
    });
  }

  // Setup on initial load
  setupViewMore();
  
  // Setup on View Transitions navigation
  document.addEventListener('astro:page-load', setupViewMore);
</script>
