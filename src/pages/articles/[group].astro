---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AIAssistant from '../../components/AIAssistant.astro';

export async function getStaticPaths() {
  return [
    { params: { group: 'group-a' }, props: { groupKey: 'A' } },
    { params: { group: 'group-b' }, props: { groupKey: 'B' } },
    { params: { group: 'group-d' }, props: { groupKey: 'D' } },
    { params: { group: 'group-e' }, props: { groupKey: 'E' } },
  ];
}

const { groupKey } = Astro.props;
const allArticles = await getCollection('articles');

const groupDefs: Record<string, {
  title: string;
  subtitle: string;
  bannerClass: string;
  pillarSlug: string;
  categories: string[];
}> = {
  A: {
    title: '拉卡拉POS办理指南',
    subtitle: '从申请条件、办理流程到激活使用，全方位解答',
    bannerClass: 'from-brand-900 via-brand-800 to-brand-700',
    pillarSlug: 'lakala-pos-banli-zhinan',
    categories: ['办理条件', '申请流程', '费用与合同', '渠道与避坑', '激活与使用'],
  },
  B: {
    title: '拉卡拉POS费率与费用',
    subtitle: '手续费、押金、流量费、秒到费，一次讲清所有费用问题',
    bannerClass: 'from-brand-900 via-brand-800 to-brand-700',
    pillarSlug: 'lakala-pos-feilv-zhinan',
    categories: ['手续费计算', '扫码费率', '流量费', '押金规则', '秒到费与涨价'],
  },
  D: {
    title: '拉卡拉POS使用问题与售后',
    subtitle: '不到账、交易失败、限额、换卡、注销，手把手教你处理各种问题',
    bannerClass: 'from-brand-900 via-brand-800 to-brand-700',
    pillarSlug: 'lakala-pos-shiyong-wenti-zhinan',
    categories: ['不到账', '交易失败', '限额', '结算卡与账户', '机器故障、流量卡、注销'],
  },
  E: {
    title: '拉卡拉POS安全合规与避坑',
    subtitle: '正规性、风控、跳码、骗局识别，帮你避开所有坑',
    bannerClass: 'from-amber-900 via-orange-800 to-amber-700',
    pillarSlug: 'lakala-pos-anquan-hegui-zhinan',
    categories: ['正规性与安全', '政策与行业变化', '风控、跳码、商户', '使用边界与风险提示', '骗局与避坑'],
  },
};

const group = groupDefs[groupKey];
const groupCats = new Set(group.categories);
const pillar = allArticles.find(a => a.id === group.pillarSlug);
const clusters = allArticles
  .filter(a => a.data.type === 'cluster' && groupCats.has(a.data.category));
const groupEntries = group.categories
  .map((category) => [category, clusters.filter((a) => a.data.category === category)] as const)
  .filter(([, items]) => items.length > 0);

// Group clusters by category in order
const grouped = new Map<string, typeof clusters>();
for (const cat of group.categories) {
  const items = clusters.filter(a => a.data.category === cat);
  if (items.length > 0) grouped.set(cat, items);
}

const categoryBadges: Record<string, string> = {
  '办理条件': '01', '申请流程': '02', '费用与合同': '03',
  '渠道与避坑': '04', '激活与使用': '05',
  '手续费计算': '01', '扫码费率': '02', '流量费': '03',
  '押金规则': '04', '秒到费与涨价': '05',
  '不到账': '01', '交易失败': '02', '限额': '03',
  '结算卡与账户': '04', '机器故障、流量卡、注销': '05',
  '正规性与安全': '01', '政策与行业变化': '02',
  '风控、跳码、商户': '03', '使用边界与风险提示': '04', '骗局与避坑': '05',
};

const categoryDescriptions: Record<string, string> = {
  '办理条件': '了解办理拉卡拉POS需要满足的条件和准备的资料',
  '申请流程': '从提交申请到审核通过，一步步教你操作',
  '费用与合同': '费用构成、合同条款和常见收费陷阱解读',
  '渠道与避坑': '如何选择靠谱渠道，避开办理中的常见坑',
  '激活与使用': '设备激活、绑卡、APP使用和日常操作指南',
  '手续费计算': '刷卡手续费怎么算？不同金额不同费率一目了然',
  '扫码费率': '微信、支付宝、银联扫码费率和限额详解',
  '流量费': 'POS机流量费怎么扣？一年多少钱？能退吗？',
  '押金规则': '激活押金、达标返还、退款条件全解析',
  '秒到费与涨价': '秒到费、服务费、费率调整，看懂不花冤枉钱',
  '不到账': '刷卡成功但钱没到？5步排查法帮你找到原因',
  '交易失败': '各种错误提示解读，从网络到银行问题全解析',
  '限额': '单笔单日限额、扫码刷卡限额、夜间限额详解',
  '结算卡与账户': '结算卡更换、银行卡异常、账户问题处理',
  '机器故障、流量卡、注销': '设备故障、流量卡续费、机器注销流程',
  '正规性与安全': '支付牌照、一清机、资金安全、正规性判断',
  '政策与行业变化': '259文件、一机一码、政策调整影响解析',
  '风控、跳码、商户': '风控触发原因、跳码识别、商户名称和MCC码解读',
  '使用边界与风险提示': '合规使用、风险行为、误导话术识别',
  '骗局与避坑': '办理骗局、押金套路、费率陷阱、代理失联处理',
};

const totalArticles = clusters.length;
const isApplyPage = groupKey === 'A';

const applyHighlights = [
  '先确认自己是个人办理还是商户办理，再准备资料。',
  '办理前把押金、流量费、首刷条件和售后政策一次问清。',
  '优先走官方或授权渠道，避免低费率和免费送机话术误导。',
];

const applyDecisionCards = [
  {
    title: '先看适用人群',
    description: '个体商户、流动收款用户、个人临时收款和企业门店，适配机型与资料要求不同。',
    items: ['个人用户可先看电签版', '商户办理需关注营业执照与门店照片'],
  },
  {
    title: '再看办理资料',
    description: '身份证、结算银行卡、手机号是基础资料，商户通常还要补营业执照和经营场景照片。',
    items: ['证件必须清晰且在有效期内', '结算卡建议使用本人名下一类卡'],
  },
  {
    title: '最后看综合成本',
    description: '不要只看费率，押金、流量费、VIP 服务费、到账规则都要一起核算。',
    items: ['重点确认是否首刷激活', '要求对方明确退还条件和时点'],
  },
];

const applySteps = [
  {
    step: '01',
    title: '确认场景与产品',
    description: '根据是个人收款、门店经营还是企业需求，选择电签版、大 POS 或智能终端。',
  },
  {
    step: '02',
    title: '准备并提交资料',
    description: '提交身份证、银行卡、手机号，商户再补营业执照与门店资料，确保一次通过审核。',
  },
  {
    step: '03',
    title: '审核与发机',
    description: '一般 1-3 个工作日完成审核，通过后安排发货，正常 3-7 天可收到设备。',
  },
  {
    step: '04',
    title: '激活并开始使用',
    description: '开机联网、APP 实名、绑定终端和结算卡，完成首笔测试交易后即可正常使用。',
  },
];

const applyFaqs = [
  {
    question: '个人没有营业执照，能办理拉卡拉 POS 吗？',
    answer: '可以。个人用户通常可以办理拉卡拉电签版等轻量产品，只需身份证、银行卡和实名手机号，具体还要看产品和渠道要求。',
  },
  {
    question: '办理时说免费，后面为什么还可能扣费？',
    answer: '“免费”通常只代表设备费不单独收取，但仍可能存在流量费、首刷激活门槛、押金或增值服务费，所以办理前一定要逐项确认。',
  },
  {
    question: '从提交申请到可以正常使用，大概需要多久？',
    answer: '资料齐全时，审核通常 1-3 个工作日，通过后发货 3-7 天，整体通常 5-10 个工作日可完成。',
  },
  {
    question: '办理渠道怎么判断是否靠谱？',
    answer: '优先看是否官方或授权、费用是否透明、是否能提供明确的办理协议与售后联系人，不建议仅凭低费率或“免费送机”宣传下单。',
  },
];

function formatDate(dateStr: string | Date) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout title={`${group.title} - 拉卡拉`}>
  <Header />
  <main class="flex-grow pt-16 min-h-screen bg-brand-50/40">
    {isApplyPage ? (
      <>
        <section class={`bg-gradient-to-br ${group.bannerClass} text-white pt-24 pb-24 relative overflow-hidden`}>
          <div class="absolute inset-0 pointer-events-none">
            <div class="absolute -top-16 left-[-5rem] w-72 h-72 rounded-full bg-white/10 blur-3xl"></div>
            <div class="absolute top-10 right-[-4rem] w-80 h-80 rounded-full bg-brand-400/20 blur-3xl"></div>
            <div class="absolute bottom-[-6rem] left-1/3 w-[28rem] h-[18rem] bg-brand-500/20 blur-3xl"></div>
          </div>

          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] items-center">
              <div>
                <span class="inline-flex items-center rounded-full border border-white/25 bg-white/15 px-4 py-1.5 text-sm font-medium text-white backdrop-blur">
                  拉卡拉 POS 办理专题
                </span>
                <h1 class="mt-6 text-4xl md:text-5xl lg:text-6xl font-black tracking-tight leading-tight">
                  {group.title}
                </h1>
                <p class="mt-6 max-w-2xl text-lg md:text-xl text-brand-100 leading-8">
                  {group.subtitle}。围绕“能不能办、怎么准备、费用怎么看、流程怎么走、激活怎么做”五个关键问题，帮你从零快速建立完整认知。
                </p>

                <div class="mt-8 flex flex-wrap gap-3">
                  {applyHighlights.map((item) => (
                    <span class="inline-flex items-center rounded-full border border-white/20 bg-white/15 px-4 py-2 text-sm text-white backdrop-blur">
                      <span class="mr-2 inline-block h-2 w-2 rounded-full bg-brand-300"></span>
                      {item}
                    </span>
                  ))}
                </div>

                <div class="mt-10 flex flex-col sm:flex-row gap-4">
                  <a href="#decision" class="inline-flex items-center justify-center rounded-full bg-white px-8 py-3.5 text-brand-900 font-bold shadow-lg shadow-black/10 transition-colors hover:bg-brand-50">
                    先看办理决策
                  </a>
                  <a href="#knowledge-map" class="inline-flex items-center justify-center rounded-full border border-white/25 bg-white/15 px-8 py-3.5 text-white font-bold backdrop-blur transition-colors hover:bg-white/20">
                    浏览知识地图
                  </a>
                </div>

                <div class="mt-12 grid gap-4 sm:grid-cols-3">
                  <div class="rounded-2xl border border-white/20 bg-white/15 p-5 backdrop-blur">
                    <div class="text-3xl font-black">{group.categories.length}</div>
                    <div class="mt-1 text-sm text-brand-100">核心专题模块</div>
                  </div>
                  <div class="rounded-2xl border border-white/20 bg-white/15 p-5 backdrop-blur">
                    <div class="text-3xl font-black">{totalArticles}</div>
                    <div class="mt-1 text-sm text-brand-100">关联专题文章</div>
                  </div>
                  <div class="rounded-2xl border border-white/20 bg-white/15 p-5 backdrop-blur">
                    <div class="text-3xl font-black">1-3 天</div>
                    <div class="mt-1 text-sm text-brand-100">常规审核周期</div>
                  </div>
                </div>
              </div>

              <div class="relative">
                <div class="rounded-[2rem] border border-white/20 bg-white/15 p-6 md:p-8 shadow-2xl shadow-brand-900/20 backdrop-blur-xl">
                  <div class="flex items-center justify-between">
                    <div>
                      <p class="text-sm uppercase tracking-[0.24em] text-brand-100">办理速览</p>
                      <h2 class="mt-2 text-2xl font-bold text-white">新手最容易踩坑的 3 件事</h2>
                    </div>
                    <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-white/20 text-lg font-bold text-white">A</div>
                  </div>

                  <div class="mt-8 space-y-4">
                    <div class="rounded-2xl border border-white/10 bg-white/12 p-5">
                      <p class="text-sm text-brand-100">先明确你的办理身份</p>
                      <p class="mt-2 text-base font-semibold text-white">个人办理和商户办理，资料要求、适用产品、审核方式都不同。</p>
                    </div>
                    <div class="rounded-2xl border border-white/10 bg-white/12 p-5">
                      <p class="text-sm text-brand-100">不要只盯着“免费送机”</p>
                      <p class="mt-2 text-base font-semibold text-white">真正影响成本的是押金、流量费、首刷达标和后续费率规则。</p>
                    </div>
                    <div class="rounded-2xl border border-white/10 bg-white/12 p-5">
                      <p class="text-sm text-brand-100">优先确认售后是否可追踪</p>
                      <p class="mt-2 text-base font-semibold text-white">能否提供办理协议、售后联系人和官方/授权身份，比低费率更重要。</p>
                    </div>
                  </div>

                  <div class="mt-8 grid grid-cols-2 gap-4">
                    <div class="rounded-2xl bg-brand-900/25 p-4">
                      <div class="text-sm text-brand-100">建议先读</div>
                      <div class="mt-1 font-semibold text-white">资料准备</div>
                    </div>
                    <div class="rounded-2xl bg-brand-900/25 p-4">
                      <div class="text-sm text-brand-100">再确认</div>
                      <div class="mt-1 font-semibold text-white">费用与合同</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-10 relative z-20">
          <div class="rounded-3xl border border-brand-100 bg-white/95 p-5 shadow-xl shadow-brand-100/60 backdrop-blur">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
              <div>
                <p class="text-sm font-semibold text-brand-600">页面导航</p>
                <p class="mt-1 text-sm text-brand-800/70">按照办理前决策、流程、完整指南、专题地图和常见问题的顺序阅读。</p>
              </div>
              <div class="flex flex-wrap gap-3">
                <a href="#decision" class="rounded-full border border-brand-100 bg-brand-50 px-4 py-2 text-sm font-medium text-brand-800 transition-colors hover:bg-brand-100 hover:text-brand-900">办理决策</a>
                <a href="#process" class="rounded-full border border-brand-100 bg-brand-50 px-4 py-2 text-sm font-medium text-brand-800 transition-colors hover:bg-brand-100 hover:text-brand-900">办理流程</a>
                <a href="#pillar-guide" class="rounded-full border border-brand-100 bg-brand-50 px-4 py-2 text-sm font-medium text-brand-800 transition-colors hover:bg-brand-100 hover:text-brand-900">完整指南</a>
                <a href="#knowledge-map" class="rounded-full border border-brand-100 bg-brand-50 px-4 py-2 text-sm font-medium text-brand-800 transition-colors hover:bg-brand-100 hover:text-brand-900">知识地图</a>
                <a href="#faq" class="rounded-full border border-brand-100 bg-brand-50 px-4 py-2 text-sm font-medium text-brand-800 transition-colors hover:bg-brand-100 hover:text-brand-900">常见问题</a>
              </div>
            </div>
          </div>
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20 space-y-20">
          <section id="decision">
            <div class="max-w-3xl">
              <p class="text-sm font-semibold tracking-[0.24em] text-brand-600">办理决策</p>
              <h2 class="mt-3 text-3xl md:text-4xl font-black tracking-tight text-slate-900">办理前，先把关键决策做对</h2>
              <p class="mt-4 text-lg leading-8 text-slate-600">
                第一次办理拉卡拉 POS，最容易卡在适用人群、资料准备和实际成本这三个问题。先把这 3 点看明白，后面的申请和激活会更顺利。
              </p>
            </div>

            <div class="mt-10 grid gap-6 lg:grid-cols-3">
              {applyDecisionCards.map((card, index) => (
                <div class="rounded-3xl border border-brand-100 bg-white p-7 shadow-sm shadow-brand-100/50">
                  <div class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-brand-50 text-brand-700 text-sm font-black">
                    0{index + 1}
                  </div>
                  <h3 class="mt-5 text-xl font-bold text-slate-900">{card.title}</h3>
                  <p class="mt-3 text-sm leading-7 text-slate-600">{card.description}</p>
                  <div class="mt-5 space-y-3">
                    {card.items.map((item) => (
                      <div class="flex items-start gap-3 rounded-2xl border border-brand-100 bg-brand-50/70 px-4 py-3 text-sm text-brand-900">
                        <span class="mt-1 inline-block h-2 w-2 rounded-full bg-brand-500"></span>
                        <span>{item}</span>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>

          <section id="process">
            <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
              <div class="max-w-3xl">
                <p class="text-sm font-semibold tracking-[0.24em] text-brand-600">办理流程</p>
                <h2 class="mt-3 text-3xl md:text-4xl font-black tracking-tight text-slate-900">标准办理流程，一屏看懂</h2>
                <p class="mt-4 text-lg leading-8 text-slate-600">
                  从明确使用场景，到资料审核、收货激活，再到正式使用，整个办理路径并不复杂，关键在于每一步都确认清楚。
                </p>
              </div>
              <div class="rounded-2xl border border-brand-100 bg-brand-50 px-5 py-4 text-sm text-brand-700">
                标准周期：资料齐全通常 5-10 个工作日完成办理并上线使用
              </div>
            </div>

            <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
              {applySteps.map((item) => (
                <div class="rounded-3xl border border-brand-100 bg-white p-6 shadow-sm shadow-brand-100/40">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-bold tracking-[0.24em] text-brand-400">步骤</span>
                    <span class="text-3xl font-black text-brand-600">{item.step}</span>
                  </div>
                  <h3 class="mt-6 text-xl font-bold text-slate-900">{item.title}</h3>
                  <p class="mt-3 text-sm leading-7 text-slate-600">{item.description}</p>
                </div>
              ))}
            </div>
          </section>

          {pillar && (
            <section id="pillar-guide">
              <div class="rounded-[2rem] border border-brand-100 bg-white p-8 md:p-10 shadow-xl shadow-brand-100/50">
                <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-start">
                  <div>
                    <div class="flex flex-wrap items-center gap-3">
                      <span class="inline-flex items-center rounded-full bg-brand-50 px-3 py-1 text-xs font-bold text-brand-700 border border-brand-100">
                        支柱主文
                      </span>
                      <span class="text-sm text-brand-400">{formatDate(pillar.data.created_at)}</span>
                    </div>
                    <h2 class="mt-5 text-3xl md:text-4xl font-black tracking-tight text-slate-900">{pillar.data.title}</h2>
                    <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">{pillar.data.summary}</p>

                    <div class="mt-8 grid gap-4 sm:grid-cols-3">
                      <div class="rounded-2xl border border-brand-100 bg-brand-50/70 p-5">
                        <div class="text-sm font-semibold text-slate-900">适用人群</div>
                        <div class="mt-2 text-sm leading-7 text-slate-600">个人用户、个体商户、流动商户、企业门店</div>
                      </div>
