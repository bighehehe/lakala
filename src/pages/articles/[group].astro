<script>
  function setupViewMore() {
    const buttons = document.querySelectorAll('.view-more-btn');
    buttons.forEach(btn => {
      const clone = btn.cloneNode(true);
      btn.parentNode?.replaceChild(clone, btn);
      
      clone.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const targetClass = target.getAttribute('data-target');
        if (!targetClass) return;

        const isExpanded = target.getAttribute('data-expanded') === 'true';
        const newExpandedState = !isExpanded;
        target.setAttribute('data-expanded', newExpandedState.toString());
        
        if (newExpandedState) {
          target.innerHTML = `收起文章 <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1"><path d="m18 15-6-6-6 6"/></svg>`;
        } else {
          target.innerHTML = `查看更多 <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1"><path d="m6 9 6 6 6-6"/></svg>`;
        }

        const allCards = document.querySelectorAll(`.${targetClass}`);
        
        allCards.forEach((card, index) => {
          if (index >= 3) {
            if (newExpandedState) {
              card.classList.remove('hidden');
              card.animate([
                { opacity: 0, transform: 'translateY(10px)' },
                { opacity: 1, transform: 'translateY(0)' }
              ], {
                duration: 400,
                easing: 'ease-out',
                fill: 'forwards'
              });
            } else {
              card.classList.add('hidden');
            }
          }
        });
      });
    });
  }

  setupViewMore();
  document.addEventListener('astro:page-load', setupViewMore);
</script>
