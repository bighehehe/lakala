---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AIAssistant from '../../components/AIAssistant.astro';

const groups = [
  {
    slug: 'group-a',
    title: '拉卡拉POS办理指南',
    subtitle: '从申请条件、办理流程到激活使用，40篇专题文章全方位解答',
    icon: '📋',
    bannerClass: 'from-brand-900 via-brand-800 to-brand-700',
    count: 41,
    categories: ['办理条件', '申请流程', '费用与合同', '渠道与避坑', '激活与使用'],
  },
  {
    slug: 'group-b',
    title: '拉卡拉POS费率与费用',
    subtitle: '手续费、扫码费率、流量费、押金、秒到费，50篇专题文章一次讲清',
    icon: '💰',
    bannerClass: 'from-blue-900 via-indigo-800 to-blue-700',
    count: 51,
    categories: ['手续费计算', '扫码费率', '流量费', '押金规则', '秒到费与涨价'],
  },
  {
    slug: 'group-c',
    title: '拉卡拉POS产品与机型',
    subtitle: '机型介绍、产品选择、功能详解，41篇文章帮你选对机器',
    icon: '📱',
    bannerClass: 'from-purple-900 via-violet-800 to-purple-700',
    count: 41,
    categories: ['机型介绍', '产品选择', '产品功能', '产品对比与决策'],
  },
  {
    slug: 'group-d',
    title: '拉卡拉POS使用问题与售后',
    subtitle: '不到账、交易失败、限额、换卡、注销，51篇文章手把手教你处理',
    icon: '🔧',
    bannerClass: 'from-rose-900 via-pink-800 to-rose-700',
    count: 51,
    categories: ['不到账', '交易失败', '限额', '结算卡与账户', '机器故障、流量卡、注销'],
  },
  {
    slug: 'group-e',
    title: '拉卡拉POS安全合规与避坑',
    subtitle: '正规性、风控、跳码、骗局识别，51篇文章帮你避开所有坑',
    icon: '🛡️',
    bannerClass: 'from-amber-900 via-orange-800 to-amber-700',
    count: 51,
    categories: ['正规性与安全', '政策与行业变化', '风控、跳码、商户', '使用边界与风险提示', '骗局与避坑'],
  },
];
---

<Layout title="资讯动态 - 拉卡拉">
  <Header />
  <main class="flex-grow pt-20 min-h-screen bg-slate-50">
    <div class="bg-gradient-to-br from-brand-900 via-brand-800 to-brand-700 text-white py-16 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-10 left-10 w-72 h-72 bg-white rounded-full blur-3xl"></div>
        <div class="absolute bottom-10 right-10 w-96 h-96 bg-blue-300 rounded-full blur-3xl"></div>
      </div>
      <div class="max-w-7xl mx-auto px-4 text-center relative z-10">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">拉卡拉POS专题</h1>
        <p class="text-blue-200 text-lg max-w-2xl mx-auto">五大专题，230+篇文章，全面解答POS办理、费用、产品、售后与安全避坑问题</p>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-5">
        {groups.map((group) => (
          <a
            href={`/articles/${group.slug}`}
            class="group bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden border-2 border-slate-100 hover:border-brand-300"
          >
            <div class={`bg-gradient-to-br ${group.bannerClass} p-6 text-white`}>
              <span class="text-4xl mb-3 block">{group.icon}</span>
              <h2 class="text-2xl font-bold mb-2 group-hover:text-blue-200 transition-colors">{group.title}</h2>
              <p class="text-blue-200 text-sm leading-relaxed">{group.subtitle}</p>
            </div>
            <div class="p-6">
              <div class="flex items-center justify-between mb-4">
                <span class="text-2xl font-bold text-brand-600">{group.count}<span class="text-sm font-normal text-slate-400 ml-1">篇文章</span></span>
                <span class="inline-flex items-center text-brand-600 text-sm font-medium group-hover:translate-x-1 transition-transform">
                  查看全部
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </span>
              </div>
              <div class="flex flex-wrap gap-2">
                {group.categories.map((cat) => (
                  <span class="inline-flex items-center px-2.5 py-1 bg-slate-50 text-slate-600 text-xs rounded-md">{cat}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
  <Footer />
  <AIAssistant />
</Layout>
