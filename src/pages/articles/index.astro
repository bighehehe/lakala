---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AIAssistant from '../../components/AIAssistant.astro';

const articles = await getCollection('articles');

const sortedArticles = articles.sort((a, b) => {
  const dateA = new Date(a.data.created_at).getTime();
  const dateB = new Date(b.data.created_at).getTime();
  return dateB - dateA;
});

function formatDate(dateStr: string | Date) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<Layout title="资讯动态 - 拉卡拉">
  <Header />
  <main class="flex-grow pt-20 min-h-screen bg-slate-50">
    <div class="bg-brand-900 text-white py-16">
      <div class="max-w-7xl mx-auto px-4 text-center">
        <h1 class="text-4xl font-bold mb-4">资讯动态</h1>
        <p class="text-brand-200">了解拉卡拉最新行业资讯与产品动态</p>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 py-16">
      {sortedArticles.length === 0 ? (
        <div class="text-center py-20">
          <p class="text-slate-500 text-lg">暂无文章</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedArticles.map((article) => (
            <a
              href={`/articles/${article.id}`}
              class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden group"
            >
              {article.data.cover_image && (
                <div class="h-48 overflow-hidden">
                  <img
                    src={article.data.cover_image}
                    alt={article.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                </div>
              )}
              <div class="p-6">
                <h3 class="text-xl font-bold text-slate-800 mb-3 line-clamp-2 group-hover:text-brand-600 transition-colors">
                  {article.data.title}
                </h3>
                {article.data.summary && (
                  <p class="text-slate-500 text-sm mb-4 line-clamp-3">{article.data.summary}</p>
                )}
                <div class="flex items-center justify-between text-xs text-slate-400">
                  <div class="flex items-center space-x-4">
                    <span class="flex items-center">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                      {article.data.author}
                    </span>
                    <span class="flex items-center">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                      {formatDate(article.data.created_at)}
                    </span>
                  </div>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform text-brand-600"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </main>
  <Footer />
  <AIAssistant />
</Layout>
