---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AIAssistant from '../../components/AIAssistant.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

// Group definitions: each group has its own pillar, categories, and sidebar
const groups = {
  A: {
    pillarSlug: 'lakala-pos-banli-zhinan',
    name: 'POS办理指南',
    categories: ['办理条件', '申请流程', '费用与合同', '渠道与避坑', '激活与使用'],
  },
  B: {
    pillarSlug: 'lakala-pos-feilv-zhinan',
    name: 'POS费率与费用',
    categories: ['手续费计算', '扫码费率', '流量费', '押金规则', '秒到费与涨价'],
  },
  C: {
    pillarSlug: 'lakala-pos-jixing-zhinan',
    name: 'POS产品与机型',
    categories: ['机型介绍', '产品选择', '产品功能', '产品对比与决策'],
  },
  D: {
    pillarSlug: 'lakala-pos-shiyong-wenti-zhinan',
    name: 'POS使用问题与售后',
    categories: ['不到账', '交易失败', '限额', '结算卡与账户', '机器故障、流量卡、注销'],
  },
  E: {
    pillarSlug: 'lakala-pos-anquan-hegui-zhinan',
    name: 'POS安全合规与避坑',
    categories: ['正规性与安全', '政策与行业变化', '风控、跳码、商户', '使用边界与风险提示', '骗局与避坑'],
  },
} as const;

// Determine current article's group
const allCategoryGroupMap = new Map<string, string>();
for (const [gk, gv] of Object.entries(groups)) {
  for (const cat of gv.categories) {
    allCategoryGroupMap.set(cat, gk);
  }
}
function getArticleGroup(art: { id: string; data: { type?: string; category?: string } }): string {
  if (art.data.type === 'pillar') {
    for (const [gk, gv] of Object.entries(groups)) {
      if (art.id === gv.pillarSlug) return gk;
    }
  }
  if (art.data.category && allCategoryGroupMap.has(art.data.category)) {
    return allCategoryGroupMap.get(art.data.category)!;
  }
  return 'A'; // fallback
}
const currentGroup = getArticleGroup(article);
const groupConfig = groups[currentGroup as keyof typeof groups];

// Get only same-group cluster articles for sidebar
const allArticles = await getCollection('articles');
const groupCategories = new Set(groupConfig.categories);
const clusterArticles = allArticles
  .filter(a => a.data.type === 'cluster' && groupCategories.has(a.data.category))
  .sort((a, b) => {
    const ca = groupConfig.categories.indexOf(a.data.category);
    const cb = groupConfig.categories.indexOf(b.data.category);
    if (ca !== cb) return ca - cb;
    return new Date(b.data.created_at).getTime() - new Date(a.data.created_at).getTime();
  });

// Group by category (within same group)
const grouped = new Map<string, typeof clusterArticles>();
for (const cat of groupConfig.categories) {
  const items = clusterArticles.filter(a => a.data.category === cat);
  if (items.length > 0) grouped.set(cat, items);
}

const categoryIcons: Record<string, string> = {
  '办理条件': '📋',
  '申请流程': '📝',
  '费用与合同': '💰',
  '渠道与避坑': '🛡️',
  '激活与使用': '🔧',
  '手续费计算': '🧮',
  '扫码费率': '📱',
  '流量费': '📶',
  '押金规则': '🔐',
  '秒到费与涨价': '⚡',
  '机型介绍': '📱',
  '产品选择': '🎯',
  '产品功能': '⚙️',
  '产品对比与决策': '⚖️',
  '不到账': '❌',
  '交易失败': '⚠️',
  '限额': '📊',
  '结算卡与账户': '💳',
  '机器故障、流量卡、注销': '🔧',
  '正规性与安全': '🔒',
  '政策与行业变化': '📜',
  '风控、跳码、商户': '🔍',
  '使用边界与风险提示': '⚠️',
  '骗局与避坑': '🚫',
};

const groupRouteMap: Record<string, string> = { A: '/articles/group-a', B: '/articles/group-b', C: '/articles/group-c', D: '/articles/group-d', E: '/articles/group-e' };

function formatDate(dateStr: string | Date) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<Layout title={`${article.data.title} - 拉卡拉`} description={article.data.summary}>
  <Header />
  <main class="flex-grow pt-20 min-h-screen bg-white">
    <div class="max-w-7xl mx-auto px-4 py-12">
      <div class="flex gap-8">

        <!-- ====== Left Sidebar ====== -->
        <aside class="hidden lg:block w-72 flex-shrink-0">
          <div class="sticky top-24 pt-4 pb-8 h-[calc(100vh-6rem)] flex flex-col">
            <!-- Back link -->
            <a href={groupRouteMap[currentGroup] || '/articles'} class="inline-flex items-center text-brand-600 hover:text-brand-700 mb-6 font-medium text-sm flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1.5"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
              返回{groupConfig.name}
            </a>

            <div class="bg-slate-50 rounded-2xl p-5 overflow-y-auto flex-grow scrollbar-thin scrollbar-thumb-slate-200 scrollbar-track-transparent">
              <h3 class="text-sm font-bold text-slate-800 mb-4 flex items-center gap-2">
                <span class="w-6 h-6 bg-brand-600 text-white rounded-md flex items-center justify-center text-xs font-bold">导</span>
                {groupConfig.name}
              </h3>

              {Array.from(grouped.entries()).map(([category, articles]) => (
                <div class="mb-5 last:mb-0">
                  <div class="flex items-center gap-1.5 mb-2.5">
                    <span class="text-sm">{categoryIcons[category] || '📄'}</span>
                    <span class="text-xs font-bold text-slate-600 uppercase tracking-wider">{category}</span>
                  </div>
                  <ul class="space-y-1">
                    {articles.map((a) => {
                      const isActive = a.id === article.id;
                      return (
                        <li>
                          <a
                            href={`/articles/${a.id}`}
                            class:list={[
                              'block text-sm rounded-lg px-3 py-2 transition-colors leading-snug',
                              isActive
                                ? 'bg-brand-600 text-white font-semibold'
                                : 'text-slate-600 hover:bg-slate-100 hover:text-brand-600',
                            ]}
                          >
                            {a.data.title}
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </aside>

        <!-- ====== Main Content ====== -->
        <div class="flex-1 min-w-0">
          <!-- Mobile back link -->
          <a href={groupRouteMap[currentGroup] || '/articles'} class="lg:hidden inline-flex items-center text-brand-600 hover:text-brand-700 mb-6 font-medium text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1.5"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            返回{groupConfig.name}
          </a>

          <article>
            <h1 class="text-3xl md:text-4xl font-bold text-slate-800 mb-6 leading-tight">
              {article.data.title}
            </h1>

            <div class="flex items-center space-x-6 text-sm text-slate-500 mb-8 pb-6 border-b border-slate-200">
              <span class="flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                {article.data.author}
              </span>
              <span class="flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                {formatDate(article.data.created_at)}
              </span>
            </div>

            <div class="prose-content text-slate-700 leading-relaxed text-lg">
              <Content />
            </div>
          </article>
        </div>

      </div>
    </div>
  </main>
  <Footer />
  <AIAssistant />
</Layout>
