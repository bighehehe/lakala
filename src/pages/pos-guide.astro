---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AIAssistant from '../components/AIAssistant.astro';

const allArticles = await getCollection('articles');

const group = {
  title: '拉卡拉POS办理指南',
  subtitle: '从办理条件、资料准备、费用确认到激活使用，一页讲清拉卡拉POS怎么办理。',
  pillarSlug: 'lakala-pos-banli-zhinan',
  categories: ['办理条件', '申请流程', '费用与合同', '渠道与避坑', '激活与使用'],
};

const groupCats = new Set(group.categories);
const pillar = allArticles.find((article) => article.id === group.pillarSlug);
const pillarRender = pillar ? await render(pillar) : null;
const PillarContent = pillarRender?.Content;
const pillarHeadings = (pillarRender?.headings ?? []).filter((heading) => heading.depth === 2);
const clusters = allArticles
  .filter((article) => article.data.type === 'cluster' && groupCats.has(article.data.category))
  .sort((a, b) => {
    const categoryDelta = group.categories.indexOf(a.data.category) - group.categories.indexOf(b.data.category);
    if (categoryDelta !== 0) return categoryDelta;
    return new Date(b.data.created_at).getTime() - new Date(a.data.created_at).getTime();
  });

const groupEntries = group.categories
  .map((category) => [category, clusters.filter((article) => article.data.category === category)] as const)
  .filter(([, items]) => items.length > 0);

function formatDate(dateStr: string | Date) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
}

const articleSchema = pillar ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pillar.data.title,
  "description": pillar.data.summary,
  "image": pillar.data.cover_image ? `https://www.pospee.com${encodeURI(pillar.data.cover_image)}` : undefined,
  "author": {
    "@type": "Organization",
    "name": pillar.data.author || "拉卡拉官方"
  },
  "publisher": {
    "@type": "Organization",
    "name": "拉卡拉",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.pospee.com/img/logo.webp"
    }
  },
  "datePublished": new Date(pillar.data.created_at).toISOString(),
  "dateModified": pillar.data.updated_at ? new Date(pillar.data.updated_at).toISOString() : new Date(pillar.data.created_at).toISOString()
} : undefined;
---

<Layout title={`${group.title} - 拉卡拉`} description={group.subtitle} schema={articleSchema}>
  <Header />
  <main class="flex-grow pt-16 min-h-screen bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <nav class="mb-6 text-sm text-slate-500">
        <ol class="flex items-center space-x-2">
          <li><a href="/" class="hover:text-brand-600 transition-colors">首页</a></li>
          <li><span class="text-slate-400">/</span></li>
          <li class="text-slate-900 font-medium">{group.title}</li>
        </ol>
      </nav>

      {pillar && PillarContent ? (
        <div class="flex flex-col lg:grid gap-8 lg:grid-cols-[300px_1fr]">
          <aside class="order-1 lg:order-1 space-y-6">
            <div class="sticky top-24 rounded-lg border border-slate-200 bg-white p-5 shadow-sm" style="font-family: 'Microsoft YaHei', '微软雅黑', sans-serif;">
              <p class="text-sm font-normal tracking-[0.18em] text-brand-600 mb-4">内容目录</p>
              <nav class="space-y-1">
                {pillarHeadings.map((heading) => (
                  <a
                    href={`#${heading.slug}`}
                    class="block rounded-lg px-3 py-2 text-sm font-normal leading-6 text-slate-700 transition-colors hover:bg-brand-50 hover:text-brand-700"
                  >
                    {heading.text}
                  </a>
                ))}
              </nav>
              
              <div class="mt-8 pt-6 border-t border-slate-100">
                <p class="text-sm font-semibold tracking-[0.18em] text-brand-600 mb-4">需要帮助？</p>
                <a href="/contact" class="flex w-full items-center justify-center rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-bold text-white transition-colors hover:bg-brand-700">
                  咨询客服
                </a>
              </div>
            </div>
          </aside>

          <article class="order-2 lg:order-2 rounded-none lg:rounded-lg border-0 lg:border border-slate-200 bg-transparent lg:bg-white shadow-none lg:shadow-sm overflow-hidden">
            {pillar.data.cover_image && (
              <img
                src={encodeURI(pillar.data.cover_image)}
                alt={pillar.data.title}
                class="w-full object-contain bg-brand-50"
              />
            )}
            <header class="border-b border-slate-200 lg:border-slate-100 p-0 lg:p-10 pb-6 lg:pb-10 mb-6 lg:mb-0">
              <h1 class="text-2xl md:text-3xl font-black tracking-tight text-slate-900">{pillar.data.title}</h1>
              <p class="mt-4 text-base leading-7 text-slate-600">{pillar.data.summary}</p>
              <div class="mt-6 flex items-center gap-4 text-sm text-slate-500">
                <span>发布于 {formatDate(pillar.data.created_at)}</span>
                {pillar.data.updated_at && (
                  <>
                    <span class="w-1 h-1 rounded-full bg-slate-300"></span>
                    <span>更新于 {formatDate(pillar.data.updated_at)}</span>
                  </>
                )}
              </div>
            </header>
            <div class="p-0 lg:p-10">
              <div class="prose-content text-base leading-relaxed text-slate-700">
                <PillarContent />
              </div>
            </div>
          </article>
        </div>
      ) : (
        <div class="rounded-lg border border-slate-200 bg-white p-10 text-center shadow-sm">
          <h1 class="text-3xl font-black tracking-tight text-slate-900">{group.title}</h1>
          <p class="mt-4 text-lg text-slate-600">{group.subtitle}</p>
        </div>
      )}

      {groupEntries.length > 0 && (
        <section class="mt-16 border-t border-slate-200 pt-16">
          <div class="mb-10 text-center">
            <h2 class="text-2xl font-black tracking-tight text-slate-900">相关专题</h2>
            <p class="mt-3 text-slate-600">深入了解办理流程中的各个环节</p>
          </div>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {groupEntries.map(([category, articles]) => (
              <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
                <h3 class="text-lg font-bold text-slate-900 mb-4 pb-4 border-b border-slate-100">{category}</h3>
                <ul class="space-y-3">
                  {articles.slice(0, 3).map((article) => (
                    <li>
                      <a href={`/pos-guide/${article.id}`} class="group flex items-start gap-3">
                        <span class="mt-1 text-brand-500">
                          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                          </svg>
                        </span>
                        <span class="text-sm leading-6 text-slate-600 group-hover:text-brand-700 transition-colors">
                          {article.data.title}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      )}
    </div>
  </main>
  <Footer />
  <AIAssistant />
</Layout>
