---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AIAssistant from '../components/AIAssistant.astro';

const products = [
  {
    id: 1,
    name: "拉卡拉智能POS",
    category: "智能POS",
    desc: "安卓系统，5.5寸高清触屏，内置高速打印机，支持海量APP下载。",
    features: ["Android 11 系统", "4G + WiFi 双模", "5000mAh 大电池", "支持扫码/刷卡/NFC"],
    image: "/img/拉卡拉大POS.jpg"
  },
  {
    id: 2,
    name: "拉卡拉电签POS",
    category: "传统POS",
    desc: "机身小巧，功能强大。自带电子签名屏幕，无需连接手机，开机即用。",
    features: ["2.4寸 彩屏", "电子签名", "GPRS/4G 通讯", "超长待机"],
    image: "/img/拉卡拉电签.png"
  }
];
---

<Layout title="智能终端 - 拉卡拉">
  <Header />
  <main class="flex-grow pt-20 bg-slate-50 min-h-screen">
    <div class="bg-white shadow-sm py-16">
      <div class="max-w-7xl mx-auto px-4 text-center">
        <h1 class="text-4xl font-bold text-slate-800 mb-4">全系列支付终端</h1>
        <p class="text-slate-600 max-w-2xl mx-auto">
          工欲善其事，必先利其器。我们提供从手持到桌面，从扫码到刷脸的全场景支付硬件，
          通过银联安全认证，为您的生意保驾护航。
        </p>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        {products.map((product) => (
          <div class="bg-white rounded-2xl shadow-lg overflow-hidden flex flex-col md:flex-row hover:shadow-xl transition-shadow duration-300">
            <div class="md:w-1/2 relative overflow-hidden group">
              <img
                src={product.image}
                alt={product.name}
                class="w-full h-64 md:h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute top-4 left-4 bg-brand-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
                {product.category}
              </div>
            </div>
            <div class="p-8 md:w-1/2 flex flex-col justify-between">
              <div>
                <h3 class="text-2xl font-bold text-slate-800 mb-2">{product.name}</h3>
                <p class="text-slate-600 mb-6 text-sm leading-relaxed">{product.desc}</p>
                <ul class="space-y-2 mb-8">
                  {product.features.map((feat) => (
                    <li class="flex items-center text-sm text-slate-500">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-500 mr-2"><path d="M21.801 10A10 10 0 1 1 17 3.335"/><path d="m9 11 3 3L22 4"/></svg>
                      {feat}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="flex space-x-4">
                <button class="inline-flex items-center justify-center font-medium transition-all duration-200 rounded-full focus:outline-none focus:ring-2 focus:ring-offset-2 bg-brand-600 hover:bg-brand-700 text-white shadow-lg shadow-brand-500/30 focus:ring-brand-500 px-4 py-1.5 text-sm flex-1">查看详情</button>
                <button class="inline-flex items-center justify-center font-medium transition-all duration-200 rounded-full focus:outline-none focus:ring-2 focus:ring-offset-2 border-2 border-brand-600 text-brand-600 hover:bg-brand-50 focus:ring-brand-500 px-4 py-1.5 text-sm flex-1">立即办理</button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="bg-white py-16">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12 text-slate-800">如何选择适合您的设备？</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr>
                <th class="p-4 border-b-2 border-slate-100 text-slate-500 font-semibold">功能特性</th>
                <th class="p-4 border-b-2 border-brand-100 text-brand-700 font-bold bg-brand-50 rounded-t-lg">智能POS</th>
                <th class="p-4 border-b-2 border-slate-100 text-slate-800 font-bold">电签POS</th>
              </tr>
            </thead>
            <tbody class="text-sm text-slate-600">
              <tr>
                <td class="p-4 border-b border-slate-100 font-medium">刷卡/插卡</td>
                <td class="p-4 border-b border-brand-50 bg-brand-50 text-brand-700">支持</td>
                <td class="p-4 border-b border-slate-100">支持</td>
              </tr>
              <tr>
                <td class="p-4 border-b border-slate-100 font-medium">扫码支付</td>
                <td class="p-4 border-b border-brand-50 bg-brand-50 text-brand-700">主扫/被扫</td>
                <td class="p-4 border-b border-slate-100">主扫</td>
              </tr>
              <tr>
                <td class="p-4 border-b border-slate-100 font-medium">小票打印</td>
                <td class="p-4 border-b border-brand-50 bg-brand-50 text-brand-700">内置打印机</td>
                <td class="p-4 border-b border-slate-100 text-gray-400">电子小票</td>
              </tr>
              <tr>
                <td class="p-4 border-b border-slate-100 font-medium">适用场景</td>
                <td class="p-4 border-b border-brand-50 bg-brand-50 text-brand-700">全行业商户</td>
                <td class="p-4 border-b border-slate-100">小微/个人</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
  <Footer />
  <AIAssistant />
</Layout>
