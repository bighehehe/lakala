---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AIAssistant from '../components/AIAssistant.astro';
---

<Layout title="联系我们 - 拉卡拉">
  <Header />
  <main class="flex-grow pt-20 min-h-screen bg-slate-50">
    <div class="bg-brand-900 text-white py-16">
      <div class="max-w-7xl mx-auto px-4 text-center">
        <h1 class="text-4xl font-bold mb-4">联系我们 / 申请办理</h1>
        <p class="text-brand-200">留下您的联系方式，专业顾问将在10分钟内为您服务</p>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 py-16">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 bg-white rounded-2xl shadow-xl overflow-hidden">
        <div class="bg-brand-600 p-12 text-white flex flex-col justify-between">
          <div>
            <h3 class="text-2xl font-bold mb-8">联系方式</h3>
            <ul class="space-y-8">
              <li class="flex items-start">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-4 mt-1 flex-shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <div>
                  <h4 class="font-bold text-lg mb-1">客服热线</h4>
                  <p class="text-brand-100 text-xl font-mono">400-926-6655</p>
                  <p class="text-sm text-brand-200 mt-1">7*24小时全天候服务</p>
                </div>
              </li>
              <li class="flex items-start">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-4 mt-1 flex-shrink-0"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <div>
                  <h4 class="font-bold text-lg mb-1">工作时间</h4>
                  <p class="text-brand-100">周一至周五: 9:00 - 18:00</p>
                </div>
              </li>
            </ul>
          </div>
        </div>

        <div class="p-12">
          <h3 class="text-2xl font-bold text-slate-800 mb-6">在线申请</h3>
          <form id="contact-form" class="space-y-6">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-2">您的姓名</label>
              <input
                required
                type="text"
                name="name"
                class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all"
                placeholder="请输入姓名"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-2">联系电话</label>
              <input
                required
                type="tel"
                name="phone"
                class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all"
                placeholder="请输入手机号码"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-2">咨询类型</label>
              <select
                name="type"
                class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all bg-white"
              >
                <option value="merchant">我是商户，想办理机器</option>
                <option value="agent">我想做代理，咨询政策</option>
                <option value="support">我是老用户，售后报修</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-2">留言备注 (选填)</label>
              <textarea
                name="message"
                rows={4}
                class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all"
                placeholder="请简要描述您的需求..."
              ></textarea>
            </div>
            <button type="submit" class="inline-flex items-center justify-center font-medium transition-all duration-200 rounded-full focus:outline-none focus:ring-2 focus:ring-offset-2 bg-brand-600 hover:bg-brand-700 text-white shadow-lg shadow-brand-500/30 focus:ring-brand-500 px-8 py-3.5 text-lg w-full">
              提交申请
            </button>
            <p class="text-xs text-slate-400 text-center mt-4">
              提交即代表您同意我们的隐私政策，您的信息将严格保密，仅用于业务联系。
            </p>
          </form>
        </div>
      </div>
    </div>
  </main>
  <Footer />
  <AIAssistant />
</Layout>

<script>
  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert("申请提交成功！我们的客户经理会在24小时内联系您。");
    form.reset();
  });
</script>
