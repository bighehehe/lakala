---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AIAssistant from '../../components/AIAssistant.astro';
import ApplyModal from '../../components/ApplyModal.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  // 只保留属于 POS办理指南 (Group A) 的集群文章，扩展分类以包含新增文章
  const groupACats = ['办理条件', '申请流程', '费用与合同', '手续费计算', '渠道与避坑', '风控、跳码、商户', '正规性与安全', '骗局与避坑', '激活与使用'];
  const filtered = articles.filter(a => a.id !== 'lakala-pos-banli-zhinan' && groupACats.includes(a.data.category || ''));
  
  return filtered.map((article) => ({
    params: { slug: article.id },
    props: { article, allClusterArticles: filtered },
  }));
}

const { article, allClusterArticles } = Astro.props;
const { Content } = await render(article);

const currentCategory = article.data.category;

const sortedArticles = [...allClusterArticles].sort((a, b) => {
  const catOrder = ['办理条件', '申请流程', '费用与合同', '手续费计算', '渠道与避坑', '风控、跳码、商户', '正规性与安全', '骗局与避坑', '激活与使用'];
  const catDelta = catOrder.indexOf(a.data.category || '') - catOrder.indexOf(b.data.category || '');
  if (catDelta !== 0) return catDelta;
  return new Date(a.data.created_at).getTime() - new Date(b.data.created_at).getTime();
});

const currentIndex = sortedArticles.findIndex(a => a.id === article.id);
const prevArticle = currentIndex > 0 ? sortedArticles[currentIndex - 1] : null;
const nextArticle = currentIndex < sortedArticles.length - 1 ? sortedArticles[currentIndex + 1] : null;

const sameCategoryArticles = allClusterArticles.filter(a => a.id !== article.id && a.data.category === currentCategory);
const otherArticles = allClusterArticles.filter(a => a.id !== article.id && a.data.category !== currentCategory);
const recommendedArticles = [...sameCategoryArticles, ...otherArticles].slice(0, 3);

// Group definitions: each group has its own pillar, categories, and sidebar
const groups = {
  A: {
    pillarSlug: 'lakala-pos-banli-zhinan',
    name: 'POS办理指南',
    categories: ['办理条件', '申请流程', '费用与合同', '手续费计算', '渠道与避坑', '风控、跳码、商户', '正规性与安全', '骗局与避坑', '激活与使用'],
  },
  B: {
    pillarSlug: 'lakala-pos-feilv-zhinan',
    name: 'POS费率与费用',
    categories: ['手续费计算', '扫码费率', '流量费', '押金规则', '秒到费与涨价'],
  },
  C: {
    pillarSlug: 'lakala-pos-jixing-zhinan',
    name: 'POS产品与机型',
    categories: ['机型介绍', '产品选择', '产品功能', '产品对比与决策'],
  },
  D: {
    pillarSlug: 'lakala-pos-shiyong-wenti-zhinan',
    name: 'POS使用问题与售后',
    categories: ['不到账', '交易失败', '限额', '结算卡与账户', '机器故障、流量卡、注销'],
  },
  E: {
    pillarSlug: 'lakala-pos-anquan-hegui-zhinan',
    name: 'POS安全合规与避坑',
    categories: ['正规性与安全', '政策与行业变化', '风控、跳码、商户', '使用边界与风险提示', '骗局与避坑'],
  },
} as const;

// Determine current article's group
const allCategoryGroupMap = new Map<string, string>();
for (const [gk, gv] of Object.entries(groups)) {
  for (const cat of gv.categories) {
    allCategoryGroupMap.set(cat, gk);
  }
}

function getArticleGroup(art: { id: string; data: { type?: string; category?: string } }): string {
  if (art.data.type === 'pillar') {
    for (const [gk, gv] of Object.entries(groups)) {
      if (art.id === gv.pillarSlug) return gk;
    }
  }
  // Try to match by category
  if (art.data.category && allCategoryGroupMap.has(art.data.category)) {
    return allCategoryGroupMap.get(art.data.category)!;
  }
  // Default fallback to A (POS办理指南) since all these articles are in this group now
  return 'A'; 
}
const currentGroup = getArticleGroup(article);
const groupConfig = groups[currentGroup as keyof typeof groups];

const groupRouteMap: Record<string, string> = { A: '/pos-guide', B: '/articles/group-b', C: '/articles/group-c', D: '/faq', E: '/articles/group-e' };

function formatDate(dateStr: string | Date) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
}

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": article.data.title,
  "description": article.data.summary,
  "image": article.data.cover_image ? `https://www.pospee.com${encodeURI(article.data.cover_image)}` : undefined,
  "author": {
    "@type": "Organization",
    "name": article.data.author || "拉卡拉官方"
  },
  "publisher": {
    "@type": "Organization",
    "name": "拉卡拉",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.pospee.com/img/logo.webp"
    }
  },
  "datePublished": new Date(article.data.created_at).toISOString(),
  "dateModified": article.data.updated_at ? new Date(article.data.updated_at).toISOString() : new Date(article.data.created_at).toISOString()
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "首页",
      "item": "https://www.pospee.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": groupConfig.name,
      "item": `https://www.pospee.com${groupRouteMap[currentGroup] || '/articles'}`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": article.data.title,
      "item": `https://www.pospee.com/pos-guide/${article.id}`
    }
  ]
};
---

<Layout title={`${article.data.title} - 拉卡拉`} description={article.data.summary} keywords={article.data.keywords} schema={[articleSchema, breadcrumbSchema]}>
  <Header />
  <main class="flex-grow pt-16 min-h-screen bg-slate-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <nav class="mb-6 text-sm text-slate-500">
        <ol class="flex items-center space-x-2">
          <li><a href="/" class="hover:text-brand-600 transition-colors">首页</a></li>
          <li><span class="text-slate-400">/</span></li>
          <li><a href={groupRouteMap[currentGroup] || '/articles'} class="hover:text-brand-600 transition-colors">{groupConfig.name}</a></li>
          <li><span class="text-slate-400">/</span></li>
          <li class="text-slate-900 font-medium">{article.data.title}</li>
        </ol>
      </nav>

      <div class="max-w-6xl mx-auto">
        <div class="flex flex-col lg:flex-row gap-8 lg:gap-8">

          <div class="hidden lg:block w-[170px] flex-shrink-0 mr-0 relative">
            <div class="sticky top-24 space-y-3 w-[170px]">
              <div class="rounded-xl bg-gradient-to-br from-brand-600 to-brand-700 p-4 shadow-lg text-center">
                <p class="text-sm font-bold text-white mb-2">想要办理 POS 机？</p>
                <p class="text-xs text-white/70 mb-3">免费咨询，专业顾问一对一</p>
                <button class="apply-modal-trigger block w-full bg-white text-brand-600 font-bold text-sm py-2.5 rounded-lg hover:bg-brand-50 transition-colors cursor-pointer">
                  立即办理
                </button>
              </div>
              <div class="rounded-xl border border-slate-200 bg-white/95 backdrop-blur p-4 shadow-lg text-center">
                <p class="text-sm font-bold text-slate-800 mb-2">全国服务热线</p>
                <p class="text-base font-black text-brand-600 tracking-wide">18215536126</p>
                <p class="text-xs text-slate-400 mt-2">周一至周日 9:00-18:00</p>
              </div>
              <div class="rounded-xl border border-slate-200 bg-white/95 backdrop-blur p-4 shadow-lg text-center">
                <p class="text-sm font-bold text-slate-800 mb-3">微信扫码咨询</p>
                <img src="/wechat.jpg" alt="微信客服二维码" class="w-full aspect-square object-contain rounded-lg" />
                <p class="text-xs text-slate-400 mt-2">扫码添加客服微信</p>
              </div>
            </div>
          </div>

          <div class="max-w-4xl flex-1">
            <div class="min-w-0">
        <article class="rounded-none lg:rounded-lg border-0 lg:border border-slate-200 bg-transparent lg:bg-white shadow-none lg:shadow-sm overflow-hidden">
            {article.data.cover_image && (
              <img
                src={encodeURI(article.data.cover_image)}
                alt={article.data.title}
                class="w-full object-contain bg-brand-50"
              />
            )}
            <header class="border-b border-slate-200 lg:border-slate-100 p-0 lg:p-10 pb-6 lg:pb-10 mb-6 lg:mb-0">
              <h1 class="text-2xl md:text-3xl font-black tracking-tight text-slate-900">{article.data.title}</h1>
              <div class="mt-6 flex items-center gap-4 text-sm text-slate-500">
                <span class="flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                {article.data.author}
              </span>
              <span class="flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                {formatDate(article.data.created_at)}
              </span>
              </div>
            </header>

            <div class="p-0 lg:p-10">
              <div class="prose-content text-base leading-relaxed text-slate-700">
                <Content />
              </div>
            </div>
        </article>

        {(prevArticle || nextArticle) && (
          <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
            {prevArticle ? (
              <a href={`/pos-guide/${prevArticle.id}`} class="group flex items-center gap-3 bg-white rounded-xl border border-slate-100 shadow-sm hover:shadow-md transition-all p-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 group-hover:text-brand-600 transition-colors"><path d="m15 18-6-6 6-6"/></svg>
                </div>
                <div class="min-w-0">
                  <span class="text-xs text-slate-400 block mb-1">上一篇</span>
                  <span class="text-sm font-medium text-slate-700 group-hover:text-brand-600 transition-colors line-clamp-2 block">{prevArticle.data.title}</span>
                </div>
              </a>
            ) : <div />}
            {nextArticle ? (
              <a href={`/pos-guide/${nextArticle.id}`} class="group flex items-center justify-end gap-3 bg-white rounded-xl border border-slate-100 shadow-sm hover:shadow-md transition-all p-4 text-right">
                <div class="min-w-0">
                  <span class="text-xs text-slate-400 block mb-1">下一篇</span>
                  <span class="text-sm font-medium text-slate-700 group-hover:text-brand-600 transition-colors line-clamp-2 block">{nextArticle.data.title}</span>
                </div>
                <div class="flex-shrink-0 w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 group-hover:text-brand-600 transition-colors"><path d="m9 18 6-6-6-6"/></svg>
                </div>
              </a>
            ) : <div />}
          </div>
        )}

        <div class="lg:hidden mt-8 pb-2">
          <div class="grid grid-cols-3 gap-3">
            <button class="apply-modal-trigger flex flex-col items-center justify-center bg-gradient-to-br from-brand-600 to-brand-700 rounded-xl py-4 px-2 text-white shadow-md cursor-pointer">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mb-1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" x2="12" y1="18" y2="12"/><line x1="9" x2="15" y1="15" y2="15"/></svg>
              <span class="text-xs font-bold">立即办理</span>
            </button>
            <a href="tel:18215536126" class="flex flex-col items-center justify-center bg-white border border-slate-200 rounded-xl py-4 px-2 text-slate-700 shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mb-1.5 text-brand-600"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span class="text-xs font-bold">电话咨询</span>
              <span class="text-[10px] text-slate-400 mt-0.5">18215536126</span>
            </a>
            <button type="button" class="wechat-qr-trigger flex flex-col items-center justify-center bg-white border border-slate-200 rounded-xl py-4 px-2 text-slate-700 shadow-sm cursor-pointer">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" class="mb-1.5 text-green-500"><path d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 0 1 .213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.29.295a.326.326 0 0 0 .167-.054l1.903-1.114a.864.864 0 0 1 .717-.098 10.16 10.16 0 0 0 2.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348zM5.785 5.991c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178A1.17 1.17 0 0 1 4.623 7.17c0-.651.52-1.18 1.162-1.18zm5.813 0c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178 1.17 1.17 0 0 1-1.162-1.178c0-.651.52-1.18 1.162-1.18zm3.68 4.025c-3.737 0-6.996 2.39-6.996 5.492 0 3.11 3.259 5.492 6.996 5.492a8.27 8.27 0 0 0 2.344-.339.625.625 0 0 1 .52.075l1.46.854a.26.26 0 0 0 .133.044.233.233 0 0 0 .233-.233c0-.058-.023-.115-.038-.172l-.3-1.133a.464.464 0 0 1 .165-.515C21.798 18.801 22.758 17.127 22.758 15.508c0-3.102-3.259-5.492-6.996-5.492h.336zm-2.436 2.826c.525 0 .95.432.95.963a.957.957 0 0 1-.95.963.957.957 0 0 1-.95-.963c0-.531.425-.963.95-.963zm4.872 0c.525 0 .95.432.95.963a.957.957 0 0 1-.95.963.957.957 0 0 1-.95-.963c0-.531.425-.963.95-.963z"/></svg>
              <span class="text-xs font-bold">微信咨询</span>
              <span class="text-[10px] text-slate-400 mt-0.5">扫码添加</span>
            </button>
          </div>
        </div>

        {recommendedArticles.length > 0 && (
          <div class="mt-10">
            <h2 class="text-lg font-bold text-slate-800 mb-5 flex items-center">
              <div class="w-1 h-5 bg-brand-600 rounded-full mr-2.5"></div>
              推荐阅读
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              {recommendedArticles.map((rec) => (
                <a href={`/pos-guide/${rec.id}`} class="group bg-white rounded-xl border border-slate-100 shadow-sm hover:shadow-md transition-all overflow-hidden">
                  {rec.data.cover_image && (
                    <div class="aspect-video w-full overflow-hidden bg-slate-50">
                      <img src={encodeURI(rec.data.cover_image)} alt={rec.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                    </div>
                  )}
                  <div class="p-4">
                    <span class="inline-block px-2 py-0.5 bg-brand-50 text-brand-600 text-xs rounded mb-2">{rec.data.category}</span>
                    <h3 class="text-sm font-bold text-slate-800 group-hover:text-brand-600 transition-colors line-clamp-2">{rec.data.title}</h3>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        </div>
      </div>
    </div>
  </main>
  <Footer />
  <AIAssistant />
  <ApplyModal />

  <div id="wechat-qr-modal" class="fixed inset-0 z-[100] flex items-center justify-center hidden">
    <div id="wechat-qr-backdrop" class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>
    <div id="wechat-qr-content" class="relative w-[calc(100%-2rem)] max-w-xs mx-auto bg-white rounded-2xl shadow-2xl transform scale-95 opacity-0 transition-all duration-300 p-6 text-center">
      <button id="wechat-qr-close" class="absolute top-3 right-3 text-slate-400 hover:text-slate-600 transition-colors p-1 rounded-full hover:bg-slate-200 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
      <p class="text-base font-bold text-slate-800 mb-4">微信扫码咨询</p>
      <img src="/wechat.jpg" alt="微信客服二维码" class="w-full aspect-square object-contain rounded-lg border border-slate-100" />
      <p class="text-xs text-slate-400 mt-3">长按识别或保存图片，打开微信扫一扫</p>
    </div>
  </div>

  <script>
    function initWechatQrModal() {
      const modal = document.getElementById('wechat-qr-modal');
      const backdrop = document.getElementById('wechat-qr-backdrop');
      const content = document.getElementById('wechat-qr-content');
      const closeBtn = document.getElementById('wechat-qr-close');
      const triggers = document.querySelectorAll('.wechat-qr-trigger');

      function open() {
        if (!modal || !backdrop || !content) return;
        modal.classList.remove('hidden');
        void modal.offsetWidth;
        backdrop.classList.remove('opacity-0');
        backdrop.classList.add('opacity-100');
        content.classList.remove('opacity-0', 'scale-95');
        content.classList.add('opacity-100', 'scale-100');
        document.body.style.overflow = 'hidden';
      }

      function close() {
        if (!backdrop || !content) return;
        backdrop.classList.remove('opacity-100');
        backdrop.classList.add('opacity-0');
        content.classList.remove('opacity-100', 'scale-100');
        content.classList.add('opacity-0', 'scale-95');
        setTimeout(() => {
          modal?.classList.add('hidden');
          document.body.style.overflow = '';
        }, 300);
      }

      triggers.forEach(btn => btn.addEventListener('click', (e) => { e.preventDefault(); open(); }));
      closeBtn?.addEventListener('click', close);
      backdrop?.addEventListener('click', close);
    }

    initWechatQrModal();
    document.addEventListener('astro:page-load', initWechatQrModal);
  </script>
</Layout>
