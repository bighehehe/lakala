---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AIAssistant from '../../components/AIAssistant.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  // 只保留属于 POS办理指南 (Group A) 的集群文章，扩展分类以包含新增文章
  const groupACats = ['办理条件', '申请流程', '费用与合同', '手续费计算', '渠道与避坑', '风控、跳码、商户', '正规性与安全', '骗局与避坑', '激活与使用'];
  const filtered = articles.filter(a => a.id !== 'lakala-pos-banli-zhinan' && groupACats.includes(a.data.category || ''));
  
  return filtered.map((article) => ({
    params: { slug: article.id },
    props: { article, allClusterArticles: filtered },
  }));
}

const { article, allClusterArticles } = Astro.props;
const { Content } = await render(article);

// Get current article's category to find related articles
const currentCategory = article.data.category;

// 获取随机 3 篇推荐阅读（不包含当前文章，且最好是同一分类的，如果是支柱文章的衍生文章则优先推荐其他衍生文章）
const recommendedArticles = allClusterArticles
  .filter(a => a.id !== article.id)
  .sort(() => 0.5 - Math.random())
  .slice(0, 3);

// Group definitions: each group has its own pillar, categories, and sidebar
const groups = {
  A: {
    pillarSlug: 'lakala-pos-banli-zhinan',
    name: 'POS办理指南',
    categories: ['办理条件', '申请流程', '费用与合同', '手续费计算', '渠道与避坑', '风控、跳码、商户', '正规性与安全', '骗局与避坑', '激活与使用'],
  },
  B: {
    pillarSlug: 'lakala-pos-feilv-zhinan',
    name: 'POS费率与费用',
    categories: ['手续费计算', '扫码费率', '流量费', '押金规则', '秒到费与涨价'],
  },
  C: {
    pillarSlug: 'lakala-pos-jixing-zhinan',
    name: 'POS产品与机型',
    categories: ['机型介绍', '产品选择', '产品功能', '产品对比与决策'],
  },
  D: {
    pillarSlug: 'lakala-pos-shiyong-wenti-zhinan',
    name: 'POS使用问题与售后',
    categories: ['不到账', '交易失败', '限额', '结算卡与账户', '机器故障、流量卡、注销'],
  },
  E: {
    pillarSlug: 'lakala-pos-anquan-hegui-zhinan',
    name: 'POS安全合规与避坑',
    categories: ['正规性与安全', '政策与行业变化', '风控、跳码、商户', '使用边界与风险提示', '骗局与避坑'],
  },
} as const;

// Determine current article's group
const allCategoryGroupMap = new Map<string, string>();
for (const [gk, gv] of Object.entries(groups)) {
  for (const cat of gv.categories) {
    allCategoryGroupMap.set(cat, gk);
  }
}

function getArticleGroup(art: { id: string; data: { type?: string; category?: string } }): string {
  if (art.data.type === 'pillar') {
    for (const [gk, gv] of Object.entries(groups)) {
      if (art.id === gv.pillarSlug) return gk;
    }
  }
  // Try to match by category
  if (art.data.category && allCategoryGroupMap.has(art.data.category)) {
    return allCategoryGroupMap.get(art.data.category)!;
  }
  // Default fallback to A (POS办理指南) since all these articles are in this group now
  return 'A'; 
}
const currentGroup = getArticleGroup(article);
const groupConfig = groups[currentGroup as keyof typeof groups];

const groupRouteMap: Record<string, string> = { A: '/pos-guide', B: '/articles/group-b', C: '/articles/group-c', D: '/faq', E: '/articles/group-e' };

function formatDate(dateStr: string | Date) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
}

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": article.data.title,
  "description": article.data.summary,
  "image": article.data.cover_image ? `https://www.pospee.com${encodeURI(article.data.cover_image)}` : undefined,
  "author": {
    "@type": "Organization",
    "name": article.data.author || "拉卡拉官方"
  },
  "publisher": {
    "@type": "Organization",
    "name": "拉卡拉",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.pospee.com/img/logo.webp"
    }
  },
  "datePublished": new Date(article.data.created_at).toISOString(),
  "dateModified": article.data.updated_at ? new Date(article.data.updated_at).toISOString() : new Date(article.data.created_at).toISOString()
};
---

<Layout title={`${article.data.title} - 拉卡拉`} description={article.data.summary} schema={articleSchema}>
  <Header />
  <main class="flex-grow pt-16 min-h-screen bg-slate-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <nav class="mb-6 text-sm text-slate-500">
        <ol class="flex items-center space-x-2">
          <li><a href="/" class="hover:text-brand-600 transition-colors">首页</a></li>
          <li><span class="text-slate-400">/</span></li>
          <li><a href={groupRouteMap[currentGroup] || '/articles'} class="hover:text-brand-600 transition-colors">{groupConfig.name}</a></li>
          <li><span class="text-slate-400">/</span></li>
          <li class="text-slate-900 font-medium">{article.data.title}</li>
        </ol>
      </nav>

      <div class="min-w-0">
        <article class="rounded-none lg:rounded-lg border-0 lg:border border-slate-200 bg-transparent lg:bg-white shadow-none lg:shadow-sm overflow-hidden">
            {article.data.cover_image && (
              <img
                src={encodeURI(article.data.cover_image)}
                alt={article.data.title}
                class="w-full object-contain bg-brand-50"
              />
            )}
            <header class="border-b border-slate-200 lg:border-slate-100 p-0 lg:p-10 pb-6 lg:pb-10 mb-6 lg:mb-0">
              <h1 class="text-2xl md:text-3xl font-black tracking-tight text-slate-900">{article.data.title}</h1>
              {article.data.summary && (
                <p class="mt-4 text-base leading-7 text-slate-600">{article.data.summary}</p>
              )}
              <div class="mt-6 flex items-center gap-4 text-sm text-slate-500">
                <span class="flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                {article.data.author}
              </span>
              <span class="flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                {formatDate(article.data.created_at)}
              </span>
              </div>
            </header>

            <div class="p-0 lg:p-10">
              <div class="prose-content text-base leading-relaxed text-slate-700">
                <Content />
              </div>
            </div>
        </article>

        <!-- 推荐阅读 -->
        {recommendedArticles.length > 0 && (
          <div class="mt-12">
            <h2 class="text-xl font-bold text-slate-800 mb-6 flex items-center">
              <div class="w-1.5 h-5 bg-brand-600 rounded-full mr-3"></div>
              推荐阅读
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {recommendedArticles.map((rec) => (
                <a href={`/pos-guide/${rec.id}`} class="group flex flex-col bg-white rounded-xl border border-slate-100 shadow-sm hover:shadow-md transition-all overflow-hidden">
                  {rec.data.cover_image && (
                    <div class="aspect-video w-full overflow-hidden bg-slate-50 border-b border-slate-100">
                      <img src={encodeURI(rec.data.cover_image)} alt={rec.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                    </div>
                  )}
                  <div class="p-5 flex-grow">
                    <span class="inline-block px-2 py-1 bg-slate-50 text-slate-500 text-xs rounded mb-3">
                      {rec.data.category}
                    </span>
                    <h3 class="text-base font-bold text-slate-800 group-hover:text-brand-600 transition-colors line-clamp-2 mb-2">
                      {rec.data.title}
                    </h3>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </main>
  <Footer />
  <AIAssistant />
</Layout>
