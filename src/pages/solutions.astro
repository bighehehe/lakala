---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AIAssistant from '../components/AIAssistant.astro';

const industries = [
  {
    id: "retail",
    title: "零售连锁",
    desc: "针对便利店、商超、专卖店等场景，提供进销存管理、会员营销、多店数据互通的综合解决方案。",
    points: ["商品库存实时同步", "会员积分跨店通用", "支持称重收银一体化"],
    img: "/img/智慧零售.png"
  },
  {
    id: "restaurant",
    title: "餐饮美食",
    desc: "覆盖快餐、正餐、茶饮等业态，支持扫码点餐、后厨打印、外卖接单，提升翻台率。",
    points: ["桌台管理与预订", "智能后厨分单打印", "聚合外卖平台接单"],
    img: "/img/餐饮美食.png"
  },
  {
    id: "logistics",
    title: "物流快递",
    desc: "为物流站点、快递员提供移动收款终端，支持货到付款、运费结算，资金实时归集。",
    points: ["移动便携高续航", "电子签名留存凭证", "实时查询物流轨迹"],
    img: "/img/物流快递.png"
  },
  {
    id: "service",
    title: "生活服务",
    desc: "美容美发、健身房、洗车行等场景，重点解决会员储值、次卡管理、技师提成计算等痛点。",
    points: ["会员储值与次卡", "员工排班与提成", "微信小程序预约"],
    img: "/img/美容美发、健身房.png"
  }
];
---

<Layout title="行业解决方案 - 拉卡拉">
  <Header />
  <main class="flex-grow pt-20">
    <div class="bg-brand-900 text-white py-20 relative overflow-hidden">
      <div class="absolute inset-0 bg-[url('https://picsum.photos/1920/600?blur=5')] bg-cover bg-center opacity-20"></div>
      <div class="max-w-7xl mx-auto px-4 relative z-10 text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">行业解决方案</h1>
        <p class="text-xl text-brand-100 max-w-3xl mx-auto">
          深入洞察各行业经营痛点，用科技赋能商业，为您量身定制数字化经营方案。
        </p>
      </div>
    </div>

    <div class="bg-slate-50 py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="space-y-24">
          {industries.map((industry, index) => (
            <div id={industry.id} class={`flex flex-col lg:flex-row gap-12 items-center ${index % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}>
              <div class="lg:w-1/2">
                <div class="relative rounded-2xl overflow-hidden shadow-2xl">
                  <img src={industry.img} alt={industry.title} class="w-full h-auto object-cover" />
                  <div class="absolute top-0 right-0 bg-accent-500 text-white p-3 rounded-bl-2xl">
                    {industry.id === 'retail' && <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>}
                    {industry.id === 'restaurant' && <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" x2="6.01" y1="2" y2="2"/><line x1="10" x2="10.01" y1="2" y2="2"/></svg>}
                    {industry.id === 'logistics' && <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="13" x="4" y="8" rx="2"/><path d="M2 8h20"/><path d="M8 8V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v3"/><circle cx="9" cy="18" r="1"/><circle cx="15" cy="18" r="1"/></svg>}
                    {industry.id === 'service' && <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>}
                  </div>
                </div>
              </div>
              <div class="lg:w-1/2 space-y-6">
                <h3 class="text-3xl font-bold text-slate-800">{industry.title}</h3>
                <p class="text-lg text-slate-600 leading-relaxed">
                  {industry.desc}
                </p>
                <ul class="space-y-4">
                  {industry.points.map((point) => (
                    <li class="flex items-center bg-white p-4 rounded-lg shadow-sm border border-slate-100">
                      <span class="w-2 h-2 bg-brand-500 rounded-full mr-4"></span>
                      <span class="text-slate-700 font-medium">{point}</span>
                    </li>
                  ))}
                </ul>
                <button class="text-brand-600 font-bold hover:text-brand-700 flex items-center mt-4">
                  查看详细方案 &rarr;
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </main>
  <Footer />
  <AIAssistant />
</Layout>

<script>
  const urlParams = new URLSearchParams(window.location.search);
  const type = urlParams.get('type');
  if (type) {
    const element = document.getElementById(type);
    if (element) {
      element.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }
</script>
