---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AIAssistant from '../../components/AIAssistant.astro';
import { products } from '../../data/products';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const keySpecs = product.specs.slice(0, 3);
const scenarioSummary =
  product.category === '智能POS'
    ? '连锁门店、餐饮收银、会员运营、外卖接单'
    : product.category === '传统大POS'
      ? '高频收银门店、商超便利店、餐饮档口'
      : product.category === '电签POS'
        ? '个人小微、移动展业、上门收款'
        : '街边门店、小微摊位、轻量化收款';
---

<Layout title={`${product.name} - 智能终端 - 拉卡拉`}>
  <Header />
  <main class="flex-grow min-h-screen bg-slate-50 pt-20">
    <div class="border-b border-slate-100 bg-white">
      <div class="mx-auto flex max-w-7xl px-4 py-4 text-sm text-slate-500">
        <a href="/" class="hover:text-brand-600">首页</a>
        <span class="mx-2">/</span>
        <a href="/products" class="hover:text-brand-600">智能终端</a>
        <span class="mx-2">/</span>
        <span class="font-medium text-slate-800">{product.name}</span>
      </div>
    </div>

    <section class="bg-gradient-to-b from-white via-slate-50 to-slate-50 py-10 md:py-16">
      <div class="mx-auto max-w-7xl px-4">
        <!-- 移除 items-stretch，改为默认行为或 items-start，我们通过内部结构控制等高 -->
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[0.8fr_1fr] xl:gap-12">
          <!-- 左侧：图片展示区，移除相对高度，依靠 flex 拉伸 -->
          <div class="relative overflow-hidden rounded-[28px] border border-brand-100 bg-gradient-to-br from-brand-50 via-white to-slate-100 p-4 sm:p-5 lg:p-6 flex flex-col">
            <div class="pointer-events-none absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-brand-100/70 to-transparent"></div>
            <div class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-brand-200/40 blur-3xl"></div>
            <div class="pointer-events-none absolute -left-10 bottom-0 h-40 w-40 rounded-full bg-sky-200/40 blur-3xl"></div>

            <div class="relative flex h-full flex-col justify-between">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <span class="inline-flex items-center rounded-full bg-white/90 px-4 py-1.5 text-sm font-bold text-brand-600 shadow-sm ring-1 ring-brand-100">
                    {product.category}
                  </span>
                </div>
                <div class="hidden rounded-2xl bg-white/80 px-4 py-3 text-right shadow-sm ring-1 ring-slate-200/70 backdrop-blur sm:flex">
                  <div>
                    <p class="text-xs text-slate-400">适用场景</p>
                    <p class="mt-1 text-sm font-semibold text-slate-700">{product.category}</p>
                  </div>
                </div>
              </div>

              <!-- 图片和标签水平排列 -->
              <div class="relative flex flex-1 items-center justify-center gap-8 py-5 md:py-6">
                <!-- 左侧图片 -->
                <div class="w-1/2 flex justify-center">
                  <img
                    src={product.image}
                    alt={product.name}
                    class="max-h-[320px] w-full max-w-[280px] object-contain drop-shadow-[0_24px_40px_rgba(15,23,42,0.18)] transition-transform duration-500 hover:scale-[1.03] md:max-h-[360px]"
                  />
                </div>
                
                <!-- 右侧标签 -->
                <div class="flex w-1/2 flex-col justify-center items-start gap-4">
                  {product.features.map((feat) => (
                    <div class="flex items-center rounded-2xl bg-white/85 px-4 py-3 shadow-sm ring-1 ring-slate-200/70 backdrop-blur transition-colors hover:bg-white w-max">
                      <div class="mr-3 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                      </div>
                      <p class="text-sm font-semibold text-slate-700">{feat}</p>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <div class="flex flex-col gap-6">
              <div class="rounded-[28px] bg-white p-6 shadow-sm ring-1 ring-slate-200 md:p-8 flex-1 flex flex-col justify-center">
              <div class="mb-4 flex items-center gap-3">
                <span class="inline-flex rounded-full bg-brand-50 px-3 py-1 text-xs font-bold text-brand-600">
                  官方推荐
                </span>
                <span class="text-sm text-slate-400">支持全国商户申请</span>
              </div>
              <h1 class="text-2xl font-extrabold leading-tight text-slate-900 md:text-3xl xl:text-4xl">
                {product.name}
              </h1>
              <p class="mt-4 text-sm leading-relaxed text-slate-600 md:text-base">
                {product.desc}
              </p>

              <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
                {keySpecs.map((spec) => (
                  <div class="rounded-2xl border border-slate-100 bg-slate-50 p-3.5">
                    <p class="text-xs font-medium uppercase tracking-[0.18em] text-slate-400">{spec.label}</p>
                    <p class="mt-2 text-sm font-semibold leading-5 text-slate-800">{spec.value}</p>
                  </div>
                ))}
              </div>

              <div class="mt-6 flex flex-col gap-3 sm:flex-row">
                <a href="/contact" class="inline-flex w-full items-center justify-center rounded-xl bg-brand-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-brand-500/30 transition-all duration-300 hover:bg-brand-700 hover:shadow-brand-500/40">
                  立即申请办理
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
                <a href="tel:400-926-6655" class="inline-flex w-full items-center justify-center rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-700 transition-colors duration-300 hover:border-brand-600 hover:text-brand-600">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.79 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                  电话咨询
                </a>
              </div>
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div class="rounded-3xl bg-brand-600 p-6 text-white shadow-sm">
                <p class="text-xs uppercase tracking-[0.24em] text-white">适用场景</p>
                <p class="mt-4 text-lg font-bold leading-8">{scenarioSummary}</p>
              </div>
              <div class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
                <p class="text-xs uppercase tracking-[0.24em] text-slate-400">服务保障</p>
                <ul class="mt-4 space-y-3 text-sm font-medium text-slate-700">
                  <li class="flex items-center"><span class="mr-3 h-2.5 w-2.5 rounded-full bg-emerald-500"></span>官方顾问一对一配置方案</li>
                  <li class="flex items-center"><span class="mr-3 h-2.5 w-2.5 rounded-full bg-emerald-500"></span>快速审核，支持远程指导开通</li>
                  <li class="flex items-center"><span class="mr-3 h-2.5 w-2.5 rounded-full bg-emerald-500"></span>售后响应及时，使用更省心</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 pb-16 md:pb-24">
      <!-- 移除 xl:items-start 让网格默认拉伸等高 -->
      <div class="grid grid-cols-1 gap-8 xl:grid-cols-[minmax(0,1fr)_320px]">
        <!-- 左侧产品亮点：使用 flex flex-col justify-between 吸收高度 -->
        <div class="rounded-[28px] bg-white p-8 shadow-sm ring-1 ring-slate-200 md:p-9 xl:col-start-1 xl:row-start-1 flex flex-col h-full">
          <div class="mb-6">
            <p class="text-sm font-semibold text-brand-600">产品亮点</p>
            <h2 class="mt-2 text-2xl font-bold text-slate-900 md:text-3xl">更适合门店经营的终端布局</h2>
          </div>

          <div class="grid grid-cols-1 gap-4 md:grid-cols-2 flex-1 items-center">
            {product.features.map((feat, index) => (
              <div class="rounded-2xl border border-slate-100 bg-slate-50 p-4">
                <div class="flex items-start gap-3">
                  <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-brand-600 text-xs font-bold text-white">
                    0{index + 1}
                  </div>
                  <div>
                    <h3 class="text-sm font-bold text-slate-800 md:text-[15px]">{feat}</h3>
                    <p class="mt-1.5 text-xs leading-6 text-slate-500 md:text-sm">围绕真实收款场景优化体验，兼顾效率、稳定性与后续经营扩展。</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- 右侧技术参数：移除 self-start，使用 flex flex-col justify-between 吸收高度 -->
        <div class="rounded-[28px] bg-white p-6 shadow-sm ring-1 ring-slate-200 xl:col-start-2 xl:row-start-1 flex flex-col h-full">
          <div>
            <p class="text-xs font-semibold text-brand-600 md:text-sm">技术参数</p>
            <h2 class="mt-2 text-xl font-bold text-slate-900 md:text-2xl">规格一览</h2>
          </div>
          <ul class="mt-6 flex flex-col justify-around flex-1">
            {product.specs.map((spec) => (
              <li class="border-b border-slate-100 pb-4 last:border-0 last:pb-0">
                <p class="text-[11px] uppercase tracking-[0.16em] text-slate-400">{spec.label}</p>
                <p class="mt-1.5 text-xs font-semibold leading-6 text-slate-800 md:text-sm">{spec.value}</p>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-[28px] bg-white p-8 shadow-sm ring-1 ring-slate-200 md:p-10 xl:col-start-1 xl:row-start-2">
          <p class="text-sm font-semibold text-brand-600">详细介绍</p>
          <h2 class="mt-2 text-2xl font-bold text-slate-900 md:text-3xl">设备能力与使用价值</h2>
          <div class="mt-8 text-base leading-8 text-slate-600">
            <p>{product.longDesc}</p>
          </div>
        </div>

        <div class="rounded-[28px] bg-gradient-to-br from-brand-600 to-brand-700 p-8 text-white shadow-lg shadow-brand-500/20 xl:col-start-2 xl:row-start-2">
          <p class="text-sm font-semibold text-white/80">快速咨询</p>
          <h3 class="mt-2 text-2xl font-bold">获取适合您的终端方案</h3>
          <p class="mt-4 text-sm leading-7 text-blue-50/90">
            告诉我们您的经营类型、收款场景和月交易需求，我们将为您推荐更合适的机型。
          </p>
          <div class="mt-8 space-y-3">
            <a href="/contact" class="inline-flex w-full items-center justify-center rounded-2xl bg-white px-6 py-3.5 text-base font-bold text-brand-700 transition-colors hover:bg-slate-100">
              在线提交需求
            </a>
            <a href="tel:400-926-6655" class="inline-flex w-full items-center justify-center rounded-2xl border border-white/25 px-6 py-3.5 text-base font-bold text-white transition-colors hover:bg-white/10">
              拨打 400-926-6655
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <AIAssistant />
</Layout>
