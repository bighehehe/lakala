---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AIAssistant from '../components/AIAssistant.astro';
---

<Layout>
  <Header />
  <main class="flex-grow">
    <!-- Hero Section -->
    <section class="relative bg-gradient-to-br from-brand-900 via-brand-700 to-brand-500 text-white pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden">
      <div class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 bg-white opacity-5 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-80 h-80 bg-accent-500 opacity-10 rounded-full blur-3xl"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
          <div class="mb-12 lg:mb-0 text-center lg:text-left">
            <h1 class="text-4xl lg:text-6xl font-extrabold tracking-tight mb-6 leading-tight">
              智能商业 <br/>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-100 to-white">
                从每一次支付开始
              </span>
            </h1>
            <p class="text-lg lg:text-xl text-blue-100 mb-8 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
              全渠道聚合支付，极速到账。为零售、餐饮、娱乐等全行业提供一站式数字化经营解决方案，助力商户智慧升级。
            </p>
            <div class="flex flex-col sm:flex-row justify-center lg:justify-start gap-4">
              <a href="/products" class="inline-flex items-center justify-center font-medium transition-all duration-200 rounded-full focus:outline-none focus:ring-2 focus:ring-offset-2 bg-white text-brand-700 hover:bg-gray-50 shadow-lg px-8 py-3.5 text-lg w-full sm:w-auto">
                了解产品 <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
              <a href="/contact" class="inline-flex items-center justify-center font-medium transition-all duration-200 rounded-full focus:outline-none focus:ring-2 focus:ring-offset-2 border-2 border-white text-white hover:bg-white/10 px-8 py-3.5 text-lg w-full sm:w-auto">
                立即申请
              </a>
            </div>
          </div>
          <div class="relative">
            <img
              src="/img/lishua.png"
              alt="Smart POS Terminal"
              class="rounded-2xl shadow-2xl transform lg:rotate-2 hover:rotate-0 transition-transform duration-500 border-4 border-white/20"
            />
            <div class="absolute -bottom-6 -left-6 bg-white p-4 rounded-xl shadow-xl hidden md:block">
              <div class="flex items-center space-x-3">
                <div class="bg-green-100 p-2 rounded-full text-green-600">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
                </div>
                <div>
                  <p class="text-sm text-gray-500">安全保障</p>
                  <p class="font-bold text-gray-800">银联认证终端</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Advantages -->
    <section class="py-20 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold text-slate-800 mb-4">为什么选择拉卡拉</h2>
          <div class="w-16 h-1 bg-brand-600 mx-auto rounded-full"></div>
          <p class="mt-4 text-slate-600 max-w-2xl mx-auto">
            不仅仅是支付工具，更是您生意增长的得力助手。
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-xl transition-shadow duration-300 border border-slate-100 group">
            <div class="bg-yellow-50 w-16 h-16 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-yellow-500"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-800 mb-3">极速稳定</h3>
            <p class="text-slate-600 leading-relaxed">
              毫秒级交易处理，99.99% 系统可用性，确保每一笔生意都不错过。
            </p>
          </div>
          <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-xl transition-shadow duration-300 border border-slate-100 group">
            <div class="bg-brand-50 w-16 h-16 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-600"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-800 mb-3">金融级安全</h3>
            <p class="text-slate-600 leading-relaxed">
              通过PCI-DSS认证，多重加密技术，全方位保障资金与信息安全。
            </p>
          </div>
          <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-xl transition-shadow duration-300 border border-slate-100 group">
            <div class="bg-orange-50 w-16 h-16 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-500"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-800 mb-3">全能聚合</h3>
            <p class="text-slate-600 leading-relaxed">
              支持微信、支付宝、云闪付、刷卡等全渠道支付方式，一机搞定。
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Product Showcase Strip -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="lg:grid lg:grid-cols-2 gap-16 items-center">
          <div class="order-2 lg:order-1 relative">
            <div class="grid grid-cols-2 gap-4">
              <img src="/img/拉卡拉大POS.jpg" class="rounded-2xl shadow-lg mt-8" alt="拉卡拉智能POS"/>
              <img src="/img/拉卡拉电签.png" class="rounded-2xl shadow-lg" alt="拉卡拉电签POS"/>
            </div>
          </div>
          <div class="order-1 lg:order-2 mb-12 lg:mb-0">
            <h2 class="text-3xl font-bold text-slate-800 mb-6">全系列智能终端，满足多样需求</h2>
            <p class="text-slate-600 mb-8 text-lg leading-relaxed">
              无论是大型商超、餐饮连锁，还是街边小店、流动摊位，我们都有适合您的支付终端。支持4G/WIFI通讯，超长续航，打印清晰。
            </p>

            <div class="space-y-6">
              <div class="flex items-start">
                <div class="flex-shrink-0 bg-brand-100 rounded-full p-1 mt-1 mr-4">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-600"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </div>
                <div>
                  <h4 class="text-lg font-bold text-slate-800">智能大POS</h4>
                  <p class="text-slate-500">全能旗舰，打印一体，适合高频交易</p>
                </div>
              </div>
              <div class="flex items-start">
                <div class="flex-shrink-0 bg-brand-100 rounded-full p-1 mt-1 mr-4">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-600"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </div>
                <div>
                  <h4 class="text-lg font-bold text-slate-800">电签MPOS</h4>
                  <p class="text-slate-500">小巧便携，电子签名，适合个人小微</p>
                </div>
              </div>
              <div class="flex items-start">
                <div class="flex-shrink-0 bg-brand-100 rounded-full p-1 mt-1 mr-4">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-600"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </div>
                <div>
                  <h4 class="text-lg font-bold text-slate-800">刷脸支付设备</h4>
                  <p class="text-slate-500">无感支付，会员营销，提升收银效率</p>
                </div>
              </div>
            </div>

            <div class="mt-10">
              <a href="/products" class="inline-flex items-center justify-center font-medium transition-all duration-200 rounded-full focus:outline-none focus:ring-2 focus:ring-offset-2 bg-brand-600 hover:bg-brand-700 text-white shadow-lg shadow-brand-500/30 focus:ring-brand-500 px-6 py-2.5 text-base">查看所有产品</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Solutions Preview -->
    <section class="py-20 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold text-slate-800">行业定制解决方案</h2>
          <p class="mt-4 text-slate-600">深度融合业务场景，打造智慧经营闭环</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <a href="/solutions?type=retail" class="group relative rounded-xl overflow-hidden cursor-pointer shadow-lg block">
            <img src="/img/智慧零售.png" alt="智慧零售" class="w-full h-64 object-cover transition-transform duration-500 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex flex-col justify-end p-6">
              <div class="flex items-center space-x-2 text-white mb-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="m19 9-5 5-4-4-3 3"/></svg>
                <h3 class="text-xl font-bold">智慧零售</h3>
              </div>
              <p class="text-slate-300 text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 transform translate-y-4 group-hover:translate-y-0">
                点击了解更多关于智慧零售的详细方案与成功案例。
              </p>
            </div>
          </a>
          <a href="/solutions?type=restaurant" class="group relative rounded-xl overflow-hidden cursor-pointer shadow-lg block">
            <img src="/img/餐饮美食.png" alt="餐饮美食" class="w-full h-64 object-cover transition-transform duration-500 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex flex-col justify-end p-6">
              <div class="flex items-center space-x-2 text-white mb-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>
                <h3 class="text-xl font-bold">餐饮美食</h3>
              </div>
              <p class="text-slate-300 text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 transform translate-y-4 group-hover:translate-y-0">
                点击了解更多关于餐饮美食的详细方案与成功案例。
              </p>
            </div>
          </a>
          <a href="/solutions?type=logistics" class="group relative rounded-xl overflow-hidden cursor-pointer shadow-lg block">
            <img src="/img/物流快递.png" alt="物流快递" class="w-full h-64 object-cover transition-transform duration-500 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex flex-col justify-end p-6">
              <div class="flex items-center space-x-2 text-white mb-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                <h3 class="text-xl font-bold">物流快递</h3>
              </div>
              <p class="text-slate-300 text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 transform translate-y-4 group-hover:translate-y-0">
                点击了解更多关于物流快递的详细方案与成功案例。
              </p>
            </div>
          </a>
          <a href="/solutions?type=service" class="group relative rounded-xl overflow-hidden cursor-pointer shadow-lg block">
            <img src="/img/美容美发、健身房.png" alt="生活服务" class="w-full h-64 object-cover transition-transform duration-500 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex flex-col justify-end p-6">
              <div class="flex items-center space-x-2 text-white mb-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>
                <h3 class="text-xl font-bold">生活服务</h3>
              </div>
              <p class="text-slate-300 text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 transform translate-y-4 group-hover:translate-y-0">
                点击了解更多关于生活服务的详细方案与成功案例。
              </p>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-brand-600">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold text-white mb-6">准备好升级您的支付体验了吗？</h2>
        <p class="text-blue-100 text-lg mb-8">加入数百万商户的选择，立即申请拉卡拉POS机，享受超低费率与优质服务。</p>
        <a href="/contact" class="inline-flex items-center justify-center font-medium transition-all duration-200 rounded-full focus:outline-none focus:ring-2 focus:ring-offset-2 bg-accent-500 hover:bg-accent-600 text-white shadow-lg shadow-accent-500/30 focus:ring-accent-500 px-12 py-3.5 text-lg">
          立即免费申请
        </a>
      </div>
    </section>
  </main>
  <Footer />
  <AIAssistant />
</Layout>
