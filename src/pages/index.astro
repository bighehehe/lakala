---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AIAssistant from '../components/AIAssistant.astro';
import ApplyModal from '../components/ApplyModal.astro';
import Carousel from '../components/Carousel.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');
const posGuideCategories = new Set(['办理条件', '申请流程', '费用与合同', '渠道与避坑', '激活与使用']);
const getArticleHref = (article: (typeof allArticles)[number]) =>
  posGuideCategories.has(article.data.category || '') ? `/pos-guide/${article.id}` : `/articles/${article.id}`;
const productSlides = [
  {
    image: '/img/拉卡拉大pos.png',
    alt: '拉卡拉大POS机',
    title: '拉卡拉大POS机',
    desc: '打印一体，适合门店高频交易场景',
    features: ['支持WIFI/4G双网络', '内置高速热敏打印机', '大容量电池长续航', '全渠道聚合收款'],
    link: '/products/lakala-da-pos',
  },
  {
    image: '/img/拉卡拉电签.png',
    alt: '拉卡拉电签POS机',
    title: '拉卡拉电签POS机',
    desc: '小巧便携，适合个人和小微商户',
    features: ['无需连接手机即开即用', '支持高清电子签名', '内置4G网络极速到账', '0押金快速办理'],
    link: '/products/lakala-dianqian-pos',
  },
  {
    image: '/img/拉卡拉智能pos.jpg',
    alt: '拉卡拉智能POS机',
    title: '拉卡拉智能POS机',
    desc: '安卓触屏，支持更丰富的收银能力',
    features: ['5.0英寸高清大触屏', '支持海量APP下载扩展', '自带会员营销管理', '真人语音播报防漏单'],
    link: '/products/lakala-zhineng-pos',
  },
  {
    image: '/img/拉卡拉收款码牌.jpg',
    alt: '拉卡拉收款码牌',
    title: '拉卡拉收款码牌',
    desc: '聚合扫码收款，部署轻便快捷',
    features: ['微信/支付宝/云闪付聚合', '搭配云音箱语音播报', '支持信用卡花呗支付', '免插电源即放即用'],
    link: '/products/lakala-shoukuanma',
  },
];
const latestArticles = allArticles
  .filter(article => article.data.status === 'published')
  .sort((a, b) => new Date(b.data.created_at).getTime() - new Date(a.data.created_at).getTime())
  .slice(0, 3);
---

<Layout>
  <Header />
  <main class="flex-grow">
    <!-- Hero Section -->
    <Carousel />

    <!-- Core Advantages -->
    <section class="py-20 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold text-slate-800 mb-4">为什么选择拉卡拉</h2>
          <div class="w-16 h-1 bg-brand-600 mx-auto rounded-full"></div>
          <p class="mt-4 text-slate-600 max-w-2xl mx-auto">
            不仅仅是支付工具，更是您生意增长的得力助手。
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-xl transition-shadow duration-300 border border-slate-100 group">
            <div class="bg-yellow-50 w-16 h-16 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-yellow-500"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-800 mb-3">极速稳定</h3>
            <p class="text-slate-600 leading-relaxed">
              毫秒级交易处理，99.99% 系统可用性，确保每一笔生意都不错过。
            </p>
          </div>
          <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-xl transition-shadow duration-300 border border-slate-100 group">
            <div class="bg-brand-50 w-16 h-16 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-600"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-800 mb-3">金融级安全</h3>
            <p class="text-slate-600 leading-relaxed">
              通过PCI-DSS认证，多重加密技术，全方位保障资金与信息安全。
            </p>
          </div>
          <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-xl transition-shadow duration-300 border border-slate-100 group">
            <div class="bg-orange-50 w-16 h-16 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-500"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-800 mb-3">全能聚合</h3>
            <p class="text-slate-600 leading-relaxed">
              支持微信、支付宝、云闪付、刷卡等全渠道支付方式，一机搞定。
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Product Showcase Section -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 flex flex-col items-center">
          <h2 class="text-3xl font-bold text-slate-800 mb-4">全系列智能终端</h2>
          <div class="w-16 h-1 bg-brand-600 rounded-full"></div>
        </div>
        <div class="relative w-full max-w-7xl mx-auto">
          <div class="relative w-full overflow-hidden rounded-3xl border border-slate-200 bg-slate-50 shadow-lg" id="product-showcase-carousel">
                <div class="flex transition-transform duration-500 ease-out" id="product-showcase-track">
                {productSlides.map((slide) => (
                  <div class="w-full flex-shrink-0 p-6 sm:p-8 lg:px-20 lg:py-10">
                    <div class="grid gap-12 md:grid-cols-[1.2fr_1fr] md:items-center">
                      <div class="flex items-center justify-center rounded-2xl bg-white p-6 sm:p-8 lg:p-8 shadow-sm min-h-[320px] lg:min-h-[400px]">
                        <img src={slide.image} class="max-h-[320px] lg:max-h-[360px] w-auto object-contain" alt={slide.alt} />
                      </div>
                      <div class="space-y-4">
                          <span class="inline-flex rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-600">
                            产品展示
                          </span>
                          <div>
                            <h3 class="text-3xl font-bold text-slate-900">{slide.title}</h3>
                            <p class="mt-4 text-lg leading-8 text-slate-600">{slide.desc}</p>
                          </div>
                          <ul class="space-y-3 pt-2">
                            {slide.features.map((feature) => (
                              <li class="flex items-center text-slate-600">
                                <svg class="w-5 h-5 text-brand-500 mr-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                {feature}
                              </li>
                            ))}
                          </ul>
                          <div class="pt-6">
                            <a href={slide.link} class="inline-flex items-center justify-center font-medium transition-colors rounded-full border-2 border-brand-600 bg-brand-600 text-white hover:bg-brand-700 hover:border-brand-700 px-6 py-2.5 text-base">
                              查看详情
                              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                            </a>
                          </div>
                        </div>
                    </div>
                  </div>
                ))}
              </div>

              <div class="absolute bottom-5 left-1/2 z-10 flex -translate-x-1/2 items-center gap-2">
                {productSlides.map((_, index) => (
                  <button
                    class={`product-showcase-dot h-2.5 rounded-full transition-all cursor-pointer ${index === 0 ? 'w-6 bg-brand-600' : 'w-2.5 bg-slate-300 hover:bg-slate-400'}`}
                    data-index={index}
                    aria-label={`查看第 ${index + 1} 张产品图`}
                  ></button>
                ))}
              </div>
            </div>

            <!-- 左右切换按钮（移动到容器外部，PC端外移，移动端基于图片高度完美居中，按钮极简尺寸） -->
            <button
              class="absolute -left-3 sm:-left-4 lg:-left-6 top-[184px] sm:top-[192px] md:top-1/2 z-10 flex h-8 w-8 sm:h-10 sm:w-10 lg:h-12 lg:w-12 -translate-y-1/2 items-center justify-center rounded-full bg-white text-slate-600 shadow-md border border-slate-100 transition-all hover:bg-slate-50 hover:text-brand-600 hover:scale-110 cursor-pointer"
              id="product-showcase-prev"
              aria-label="上一张产品图"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 lg:w-6 lg:h-6"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <button
              class="absolute -right-3 sm:-right-4 lg:-right-6 top-[184px] sm:top-[192px] md:top-1/2 z-10 flex h-8 w-8 sm:h-10 sm:w-10 lg:h-12 lg:w-12 -translate-y-1/2 items-center justify-center rounded-full bg-white text-slate-600 shadow-md border border-slate-100 transition-all hover:bg-slate-50 hover:text-brand-600 hover:scale-110 cursor-pointer"
              id="product-showcase-next"
              aria-label="下一张产品图"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 lg:w-6 lg:h-6"><path d="m9 18 6-6-6-6"/></svg>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Latest Articles -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-end mb-12">
          <div>
            <h2 class="text-3xl font-bold text-slate-800 mb-4">最新资讯动态</h2>
            <div class="w-16 h-1 bg-brand-600 rounded-full"></div>
          </div>
          <a href="/pos-guide" class="hidden md:flex items-center text-brand-600 hover:text-brand-700 font-medium transition-colors">
            查看更多资讯
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1"><path d="m9 18 6-6-6-6"/></svg>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {latestArticles.map(article => (
            <a href={getArticleHref(article)} class="group flex flex-col bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden">
              {article.data.cover_image && (
                <div class="aspect-video w-full overflow-hidden bg-slate-50 border-b border-slate-100">
                  <img src={encodeURI(article.data.cover_image)} alt={article.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                </div>
              )}
              <div class="p-6 md:p-8 flex-grow">
                <div class="flex items-center justify-between mb-4">
                  <span class="inline-block px-3 py-1 bg-brand-50 text-brand-600 text-xs font-bold rounded-full">
                    {article.data.category}
                  </span>
                  <span class="text-sm text-slate-400 font-medium">
                    {new Date(article.data.created_at).toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
                  </span>
                </div>
                <h3 class="text-xl font-bold text-slate-800 mb-3 group-hover:text-brand-600 transition-colors line-clamp-2">
                  {article.data.title}
                </h3>
                <p class="text-slate-500 text-sm leading-relaxed line-clamp-3">
                  {article.data.summary}
                </p>
              </div>
              <div class="px-6 md:px-8 py-4 bg-slate-50 border-t border-slate-100 flex items-center text-brand-600 text-sm font-medium group-hover:bg-brand-50 transition-colors">
                阅读全文
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2 transform group-hover:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </div>
            </a>
          ))}
        </div>
        
        <div class="mt-10 text-center md:hidden">
          <a href="/pos-guide" class="inline-flex items-center justify-center font-medium transition-colors rounded-full border-2 border-brand-600 text-brand-600 hover:bg-brand-50 px-6 py-2.5 text-base w-full sm:w-auto">
            查看更多资讯
          </a>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-brand-600">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold text-white mb-6">准备好升级您的支付体验了吗？</h2>
        <p class="text-blue-100 text-lg mb-8">加入数百万商户的选择，立即申请拉卡拉POS机，享受超低费率与优质服务。</p>
        <button class="apply-modal-trigger inline-flex items-center justify-center font-medium transition-all duration-200 rounded-full focus:outline-none focus:ring-2 focus:ring-offset-2 bg-accent-500 hover:bg-accent-600 text-white shadow-lg shadow-accent-500/30 focus:ring-accent-500 px-12 py-3.5 text-lg cursor-pointer">
          立即免费申请
        </button>
      </div>
    </section>
  </main>
  <Footer />
  <AIAssistant />
  <ApplyModal />
</Layout>

<script>
  const showcase = document.getElementById('product-showcase-carousel');
  const showcaseTrack = document.getElementById('product-showcase-track');
  const showcasePrev = document.getElementById('product-showcase-prev');
  const showcaseNext = document.getElementById('product-showcase-next');
  const showcaseDots = document.querySelectorAll('.product-showcase-dot');

  if (showcase && showcaseTrack && showcasePrev && showcaseNext && showcaseDots.length > 0) {
    let currentIndex = 0;
    const totalSlides = showcaseDots.length;
    let autoplayTimer;

    const updateShowcase = () => {
      showcaseTrack.style.transform = `translateX(-${currentIndex * 100}%)`;
      showcaseDots.forEach((dot, index) => {
        if (index === currentIndex) {
          dot.classList.remove('w-2.5', 'bg-slate-300', 'hover:bg-slate-400');
          dot.classList.add('w-6', 'bg-brand-600');
        } else {
          dot.classList.remove('w-6', 'bg-brand-600');
          dot.classList.add('w-2.5', 'bg-slate-300', 'hover:bg-slate-400');
        }
      });
    };

    const goToNext = () => {
      currentIndex = (currentIndex + 1) % totalSlides;
      updateShowcase();
    };

    const goToPrev = () => {
      currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
      updateShowcase();
    };

    const startAutoplay = () => {
      autoplayTimer = window.setInterval(goToNext, 4000);
    };

    const stopAutoplay = () => {
      if (autoplayTimer) clearInterval(autoplayTimer);
    };

    showcaseNext.addEventListener('click', () => {
      goToNext();
      stopAutoplay();
      startAutoplay();
    });

    showcasePrev.addEventListener('click', () => {
      goToPrev();
      stopAutoplay();
      startAutoplay();
    });

    showcaseDots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        currentIndex = index;
        updateShowcase();
        stopAutoplay();
        startAutoplay();
      });
    });

    showcase.addEventListener('mouseenter', stopAutoplay);
    showcase.addEventListener('mouseleave', startAutoplay);

    startAutoplay();
  }
</script>
