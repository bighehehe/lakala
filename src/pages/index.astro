---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AIAssistant from '../components/AIAssistant.astro';
import Carousel from '../components/Carousel.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');
const latestArticles = allArticles
  .filter(article => article.data.status === 'published')
  .sort((a, b) => new Date(b.data.created_at).getTime() - new Date(a.data.created_at).getTime())
  .slice(0, 3);
---

<Layout>
  <Header />
  <main class="flex-grow">
    <!-- Hero Section -->
    <Carousel />

    <!-- Core Advantages -->
    <section class="py-20 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold text-slate-800 mb-4">为什么选择拉卡拉</h2>
          <div class="w-16 h-1 bg-brand-600 mx-auto rounded-full"></div>
          <p class="mt-4 text-slate-600 max-w-2xl mx-auto">
            不仅仅是支付工具，更是您生意增长的得力助手。
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-xl transition-shadow duration-300 border border-slate-100 group">
            <div class="bg-yellow-50 w-16 h-16 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-yellow-500"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-800 mb-3">极速稳定</h3>
            <p class="text-slate-600 leading-relaxed">
              毫秒级交易处理，99.99% 系统可用性，确保每一笔生意都不错过。
            </p>
          </div>
          <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-xl transition-shadow duration-300 border border-slate-100 group">
            <div class="bg-brand-50 w-16 h-16 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-600"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-800 mb-3">金融级安全</h3>
            <p class="text-slate-600 leading-relaxed">
              通过PCI-DSS认证，多重加密技术，全方位保障资金与信息安全。
            </p>
          </div>
          <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-xl transition-shadow duration-300 border border-slate-100 group">
            <div class="bg-orange-50 w-16 h-16 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-500"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-800 mb-3">全能聚合</h3>
            <p class="text-slate-600 leading-relaxed">
              支持微信、支付宝、云闪付、刷卡等全渠道支付方式，一机搞定。
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Product Showcase Strip -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="lg:grid lg:grid-cols-2 gap-16 items-center">
          <div class="order-2 lg:order-1 relative">
            <div class="grid grid-cols-2 gap-4">
              <img src="/img/拉卡拉大pos.png" class="rounded-2xl shadow-lg mt-8" alt="拉卡拉大POS机"/>
              <img src="/img/拉卡拉电签.png" class="rounded-2xl shadow-lg" alt="拉卡拉电签POS机"/>
            </div>
          </div>
          <div class="order-1 lg:order-2 mb-12 lg:mb-0">
            <h2 class="text-3xl font-bold text-slate-800 mb-6">全系列智能终端，满足多样需求</h2>
            <p class="text-slate-600 mb-8 text-lg leading-relaxed">
              无论是大型商超、餐饮连锁，还是街边小店、流动摊位，我们都有适合您的支付终端。支持4G/WIFI通讯，超长续航，打印清晰。
            </p>

            <div class="space-y-6">
              <div class="flex items-start">
                <div class="flex-shrink-0 bg-brand-100 rounded-full p-1 mt-1 mr-4">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-600"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </div>
                <div>
                  <h4 class="text-lg font-bold text-slate-800">拉卡拉大POS机</h4>
                  <p class="text-slate-500">全能旗舰，打印一体，适合高频交易</p>
                </div>
              </div>
              <div class="flex items-start">
                <div class="flex-shrink-0 bg-brand-100 rounded-full p-1 mt-1 mr-4">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-600"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </div>
                <div>
                  <h4 class="text-lg font-bold text-slate-800">拉卡拉电签POS机</h4>
                  <p class="text-slate-500">小巧便携，电子签名，适合个人小微</p>
                </div>
              </div>
              <div class="flex items-start">
                <div class="flex-shrink-0 bg-brand-100 rounded-full p-1 mt-1 mr-4">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-600"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </div>
                <div>
                  <h4 class="text-lg font-bold text-slate-800">拉卡拉智能POS机</h4>
                  <p class="text-slate-500">安卓系统，高清触屏，支持海量APP</p>
                </div>
              </div>
              <div class="flex items-start">
                <div class="flex-shrink-0 bg-brand-100 rounded-full p-1 mt-1 mr-4">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-600"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </div>
                <div>
                  <h4 class="text-lg font-bold text-slate-800">拉卡拉收款码</h4>
                  <p class="text-slate-500">多渠道聚合支付，费率低，申请简便</p>
                </div>
              </div>
            </div>

            <div class="mt-10">
              <a href="/products/lakala-dianqian-pos" class="inline-flex items-center justify-center font-medium transition-all duration-200 rounded-full focus:outline-none focus:ring-2 focus:ring-offset-2 bg-brand-600 hover:bg-brand-700 text-white shadow-lg shadow-brand-500/30 focus:ring-brand-500 px-6 py-2.5 text-base">查看产品详情</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Industry Empowerment -->
    <section class="py-20 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold text-slate-800 mb-4">多场景覆盖，赋能千行百业</h2>
          <div class="w-16 h-1 bg-brand-600 mx-auto rounded-full"></div>
          <p class="mt-4 text-slate-600 max-w-2xl mx-auto">
            深入了解不同行业的经营痛点，量身定制专属的支付与数字化解决方案。
          </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 lg:gap-6">
          <!-- Item 1 -->
          <div class="group relative rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 h-64 md:h-80">
            <img src="/img/智慧零售.png" alt="智慧零售" class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 p-5 md:p-6">
              <h3 class="text-lg md:text-xl font-bold text-white mb-1">智慧零售</h3>
              <p class="text-white/90 text-xs md:text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 transform translate-y-2 group-hover:translate-y-0">商超便利·生鲜水果</p>
            </div>
          </div>
          <!-- Item 2 -->
          <div class="group relative rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 h-64 md:h-80">
            <img src="/img/餐饮美食.png" alt="餐饮美食" class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 p-5 md:p-6">
              <h3 class="text-lg md:text-xl font-bold text-white mb-1">餐饮美食</h3>
              <p class="text-white/90 text-xs md:text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 transform translate-y-2 group-hover:translate-y-0">正餐快餐·奶茶烘焙</p>
            </div>
          </div>
          <!-- Item 3 -->
          <div class="group relative rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 h-64 md:h-80">
            <img src="/img/美容美发、健身房.png" alt="丽人健身" class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 p-5 md:p-6">
              <h3 class="text-lg md:text-xl font-bold text-white mb-1">丽人健身</h3>
              <p class="text-white/90 text-xs md:text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 transform translate-y-2 group-hover:translate-y-0">美容美发·健身瑜伽</p>
            </div>
          </div>
          <!-- Item 4 -->
          <div class="group relative rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 h-64 md:h-80">
            <img src="/img/物流快递.png" alt="物流批发" class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 p-5 md:p-6">
              <h3 class="text-lg md:text-xl font-bold text-white mb-1">物流批发</h3>
              <p class="text-white/90 text-xs md:text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 transform translate-y-2 group-hover:translate-y-0">物流货运·批发市场</p>
            </div>
          </div>
          <!-- Item 5 -->
          <div class="group relative rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 h-64 md:h-80">
            <img src="/img/酒吧.png" alt="娱乐酒吧" class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 p-5 md:p-6">
              <h3 class="text-lg md:text-xl font-bold text-white mb-1">娱乐酒吧</h3>
              <p class="text-white/90 text-xs md:text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 transform translate-y-2 group-hover:translate-y-0">清吧夜店·KTV会所</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Latest Articles -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-end mb-12">
          <div>
            <h2 class="text-3xl font-bold text-slate-800 mb-4">最新资讯动态</h2>
            <div class="w-16 h-1 bg-brand-600 rounded-full"></div>
          </div>
          <a href="/articles" class="hidden md:flex items-center text-brand-600 hover:text-brand-700 font-medium transition-colors">
            查看更多资讯
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1"><path d="m9 18 6-6-6-6"/></svg>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {latestArticles.map(article => (
            <a href={`/articles/${article.id}`} class="group flex flex-col bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden">
              <div class="p-6 md:p-8 flex-grow">
                <div class="flex items-center justify-between mb-4">
                  <span class="inline-block px-3 py-1 bg-brand-50 text-brand-600 text-xs font-bold rounded-full">
                    {article.data.category}
                  </span>
                  <span class="text-sm text-slate-400 font-medium">
                    {new Date(article.data.created_at).toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
                  </span>
                </div>
                <h3 class="text-xl font-bold text-slate-800 mb-3 group-hover:text-brand-600 transition-colors line-clamp-2">
                  {article.data.title}
                </h3>
                <p class="text-slate-500 text-sm leading-relaxed line-clamp-3">
                  {article.data.summary}
                </p>
              </div>
              <div class="px-6 md:px-8 py-4 bg-slate-50 border-t border-slate-100 flex items-center text-brand-600 text-sm font-medium group-hover:bg-brand-50 transition-colors">
                阅读全文
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2 transform group-hover:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </div>
            </a>
          ))}
        </div>
        
        <div class="mt-10 text-center md:hidden">
          <a href="/articles" class="inline-flex items-center justify-center font-medium transition-colors rounded-full border-2 border-brand-600 text-brand-600 hover:bg-brand-50 px-6 py-2.5 text-base w-full sm:w-auto">
            查看更多资讯
          </a>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-brand-600">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold text-white mb-6">准备好升级您的支付体验了吗？</h2>
        <p class="text-blue-100 text-lg mb-8">加入数百万商户的选择，立即申请拉卡拉POS机，享受超低费率与优质服务。</p>
        <a href="/contact" class="inline-flex items-center justify-center font-medium transition-all duration-200 rounded-full focus:outline-none focus:ring-2 focus:ring-offset-2 bg-accent-500 hover:bg-accent-600 text-white shadow-lg shadow-accent-500/30 focus:ring-accent-500 px-12 py-3.5 text-lg">
          立即免费申请
        </a>
      </div>
    </section>
  </main>
  <Footer />
  <AIAssistant />
</Layout>
